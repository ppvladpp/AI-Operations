Yes}\cell\pard\plain \s187\loch\intbl\ql\nowidctlpar\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
No}\cell\pard\plain \s187\loch\intbl\ql\nowidctlpar\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
You stay, your sentence }{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
doubles}{\rtlch\ab0 \ltrch\loch\b0\loch
; opponent leaves}\cell\row\pard\trowd\trql\trleft0\ltrrow\trpaddft3\trpaddt0\trpaddfl3\trpaddl0\trpaddfb3\trpaddb0\trpaddfr3\trpaddr0\clpadfl3\clpadl28\clpadft3\clpadt28\clpadfb3\clpadb28\clpadfr3\clpadr28\clvertalc\cellx1324\clpadfl3\clpadl28\clpadft3\clpadt28\clpadfb3\clpadb28\clpadfr3\clpadr28\clvertalc\cellx3309\clpadfl3\clpadl28\clpadft3\clpadt28\clpadfb3\clpadb28\clpadfr3\clpadr28\clvertalc\cellx8246\pard\plain \s187\loch\intbl\ql\nowidctlpar\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
No}\cell\pard\plain \s187\loch\intbl\ql\nowidctlpar\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
Yes}\cell\pard\plain \s187\loch\intbl\ql\nowidctlpar\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
You leave; opponent stays, sentence doubles}\cell\row\pard\trowd\trql\trleft0\ltrrow\trpaddft3\trpaddt0\trpaddfl3\trpaddl0\trpaddfb3\trpaddb0\trpaddfr3\trpaddr0\clpadfl3\clpadl28\clpadft3\clpadt28\clpadfb3\clpadb28\clpadfr3\clpadr28\clvertalc\cellx1324\clpadfl3\clpadl28\clpadft3\clpadt28\clpadfb3\clpadb28\clpadfr3\clpadr28\clvertalc\cellx3309\clpadfl3\clpadl28\clpadft3\clpadt28\clpadfb3\clpadb28\clpadfr3\clpadr28\clvertalc\cellx8246\pard\plain \s187\loch\intbl\ql\nowidctlpar\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
