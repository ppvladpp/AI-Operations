\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ql\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1042\'c2\u1086\'ee\u1090\'f2 \u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1074\'e2\u1086\'ee\u1076\'e4 \u1087\'ef\u1088\'f0\u1077\'e5\u1076\'e4\u1099\'fb\u1076\'e4\u1091\'f3\u1097\'f9\u1077\'e5\u1075\'e3\u1086\'ee \u1086\'ee\u1090\'f2\u1074\'e2\u1077\'e5\u1090\'f2\u1072\'e0 (\u1087\'ef\u1088\'f0\u1086\'ee \u1050\'ca\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1100\'fc \u1058\'d2\u1077\'e5\u1089\'f1\u1077\'e5\u1103\'ff) \u1085\'ed\u1072\'e0 \u1088\'f0\u1091\'f3\u1089\'f1\u1089\'f1\u1082\'ea\u1080\'e8\u1081\'e9:}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1069\'dd\u1090\'f2\u1086\'ee \u1082\'ea\u1083\'eb\u1072\'e0\u1089\'f1\u1089\'f1\u1080\'e8\u1095\'f7\u1077\'e5\u1089\'f1\u1082\'ea\u1080\'e8\u1081\'e9 \u1087\'ef\u1072\'e0\u1088\'f0\u1072\'e0\u1076\'e4\u1086\'ee\u1082\'ea\u1089\'f1 }{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1050\'ca\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1103\'ff \u1058\'d2\u1077\'e5\u1089\'f1\u1077\'e5\u1103\'ff}{\rtlch\ab0 \ltrch\loch\b0\loch
, \u1074\'e2\u1087\'ef\u1077\'e5\u1088\'f0\u1074\'e2\u1099\'fb\u1077\'e5 \u1089\'f1\u1092\'f4\u1086\'ee\u1088\'f0\u1084\'ec\u1091\'f3\u1083\'eb\u1080\'e8\u1088\'f0\u1086\'ee\u1074\'e2\u1072\'e0\u1085\'ed\u1085\'ed\u1099\'fb\u1081\'e9 \u1055\'cf\u1083\'eb\u1091\'f3\u1090\'f2\u1072\'e0\u1088\'f0\u1093\'f5\u1086\'ee\u1084\'ec. \u1069\'dd\u1090\'f2\u1086\'ee \u1086\'ee\u1076\'e4\u1085\'ed\u1072\'e0 \u1080\'e8\u1079\'e7 \u1089\'f1\u1090\'f2\u1072\'e0\u1088\'f0\u1077\'e5\u1081\'e9\u1096\'f8\u1080\'e8\u1093\'f5 \u1092\'f4\u1080\'e8\u1083\'eb\u1086\'ee\u1089\'f1\u1086\'ee\u1092\'f4\u1089\'f1\u1082\'ea\u1080\'e8\u1093\'f5 \u1075\'e3\u1086\'ee\u1083\'eb\u1086\'ee\u1074\'e2\u1086\'ee\u1083\'eb\u1086\'ee\u1084\'ec\u1086\'ee\u1082\'ea \u1086\'ee \u1090\'f2\u1086\'ee\u1078\'e6\u1076\'e4\u1077\'e5\u1089\'f1\u1090\'f2\u1074\'e2\u1077\'e5 \u1080\'e8 \u1089\'f1\u1086\'ee\u1093\'f5\u1088\'f0\u1072\'e0\u1085\'ed\u1077\'e5\u1085\'ed\u1080\'e8\u1080\'e8 \u1086\'ee\u1073\'e1\u1098\'fa\u1077\'e5\u1082\'ea\u1090\'f2\u1072\'e0 \u1074\'e2\u1086\'ee \u1074\'e2\u1088\'f0\u1077\'e5\u1084\'ec\u1077\'e5\u1085\'ed\u1080\'e8 \u8212\'97 \u1077\'e5\u1076\'e4\u1080\'e8\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1088\'f0\u1077\'e5\u1096\'f8\u1105\'b8\u1085\'ed\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1086\'ee\u1090\'f2\u1074\'e2\u1077\'e5\u1090\'f2\u1072\'e0 \u1085\'ed\u1077\'e5\u1090\'f2, \u1085\'ed\u1086\'ee \u1077\'e5\u1089\'f1\u1090\'f2\u1100\'fc \u1085\'ed\u1077\'e5\u1089\'f1\u1082\'ea\u1086\'ee\u1083\'eb\u1100\'fc\u1082\'ea\u1086\'ee \u1089\'f1\u1077\'e5\u1088\'f0\u1100\'fc\u1105\'b8\u1079\'e7\u1085\'ed\u1099\'fb\u1093\'f5 \u1087\'ef\u1086\'ee\u1076\'e4\u1093\'f5\u1086\'ee\u1076\'e4\u1086\'ee\u1074\'e2 \u1082\'ea \u1101\'fd\u1090\'f2\u1086\'ee\u1084\'ec\u1091\'f3 \u1074\'e2\u1086\'ee\u1087\'ef\u1088\'f0\u1086\'ee\u1089\'f1\u1091\'f3.}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1057\'d1\u1091\'f3\u1090\'f2\u1100\'fc \u1087\'ef\u1072\'e0\u1088\'f0\u1072\'e0\u1076\'e4\u1086\'ee\u1082\'ea\u1089\'f1\u1072\'e0}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1059\'d3 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1103\'ff \u1087\'ef\u1086\'ee\u1089\'f1\u1090\'f2\u1077\'e5\u1087\'ef\u1077\'e5\u1085\'ed\u1085\'ed\u1086\'ee, \u1076\'e4\u1086\'ee\u1089\'f1\u1082\'ea\u1072\'e0 \u1079\'e7\u1072\'e0 \u1076\'e4\u1086\'ee\u1089\'f1\u1082\'ea\u1086\'ee\u1081\'e9, \u1079\'e7\u1072\'e0\u1084\'ec\u1077\'e5\u1085\'ed\u1103\'ff\u1102\'fe\u1090\'f2 \u1074\'e2\u1089\'f1\u1077\'e5 \u1101\'fd\u1083\'eb\u1077\'e5\u1084\'ec\u1077\'e5\u1085\'ed\u1090\'f2\u1099\'fb \u1074\'e2 \u1093\'f5\u1086\'ee\u1076\'e4\u1077\'e5 \u1084\'ec\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee\u1083\'eb\u1077\'e5\u1090\'f2\u1085\'ed\u1077\'e5\u1075\'e3\u1086\'ee \u1088\'f0\u1077\'e5\u1084\'ec\u1086\'ee\u1085\'ed\u1090\'f2\u1072\'e0, \u1087\'ef\u1086\'ee\u1082\'ea\u1072\'e0 \u1074\'e2 \u1080\'e8\u1090\'f2\u1086\'ee\u1075\'e3\u1077\'e5 \u1085\'ed\u1077\'e5 \u1086\'ee\u1089\'f1\u1090\'f2\u1072\'e0\u1105\'b8\u1090\'f2\u1089\'f1\u1103\'ff \u1085\'ed\u1080\'e8 \u1086\'ee\u1076\'e4\u1085\'ed\u1086\'ee\u1081\'e9 \u1086\'ee\u1088\'f0\u1080\'e8\u1075\'e3\u1080\'e8\u1085\'ed\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1086\'ee\u1081\'e9 \u1076\'e4\u1086\'ee\u1089\'f1\u1082\'ea\u1080\'e8. \u1069\'dd\u1090\'f2\u1086\'ee \u1074\'e2\u1089\'f1\u1105\'b8 \u1077\'e5\u1097\'f9\u1105\'b8 \u171\'ab\u1090\'f2\u1086\'ee\u1090\'f2 \u1078\'e6\u1077\'e5 \u1089\'f1\u1072\'e0\u1084\'ec\u1099\'fb\u1081\'e9\u187\'bb \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1100\'fc? \u1044\'c4\u1086\'ee\u1073\'e1\u1072\'e0\u1074\'e2\u1080\'e8\u1084\'ec \u1091\'f3\u1089\'f1\u1083\'eb\u1086\'ee\u1078\'e6\u1085\'ed\u1077\'e5\u1085\'ed\u1080\'e8\u1077\'e5: \u1087\'ef\u1088\'f0\u1077\'e5\u1076\'e4\u1087\'ef\u1086\'ee\u1083\'eb\u1086\'ee\u1078\'e6\u1080\'e8\u1084\'ec, \u1082\'ea\u1090\'f2\u1086\'ee-\u1090\'f2\u1086\'ee \u1089\'f1\u1086\'ee\u1073\'e1\u1080\'e8\u1088\'f0\u1072\'e0\u1083\'eb \u1074\'e2\u1089\'f1\u1077\'e5 \u1074\'e2\u1099\'fb\u1073\'e1\u1088\'f0\u1086\'ee\u1096\'f8\u1077\'e5\u1085\'ed\u1085\'ed\u1099\'fb\u1077\'e5 \u1086\'ee\u1088\'f0\u1080\'e8\u1075\'e3\u1080\'e8\u1085\'ed\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1099\'fb\u1077\'e5 \u1076\'e4\u1086\'ee\u1089\'f1\u1082\'ea\u1080\'e8 \u1080\'e8 \u1087\'ef\u1086\'ee\u1089\'f1\u1090\'f2\u1088\'f0\u1086\'ee\u1080\'e8\u1083\'eb \u1080\'e8\u1079\'e7 \u1085\'ed\u1080\'e8\u1093\'f5 \u1076\'e4\u1088\'f0\u1091\'f3\u1075\'e3\u1086\'ee\u1081\'e9 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1100\'fc. \u1050\'ca\u1072\'e0\u1082\'ea\u1086\'ee\u1081\'e9 \u1080\'e8\u1079\'e7 \u1085\'ed\u1080\'e8\u1093\'f5 \u8212\'97 \u1085\'ed\u1077\'e5\u1087\'ef\u1088\'f0\u1077\'e5\u1088\'f0\u1099\'fb\u1074\'e2\u1085\'ed\u1086\'ee \u1088\'f0\u1077\'e5\u1084\'ec\u1086\'ee\u1085\'ed\u1090\'f2\u1080\'e8\u1088\'f0\u1091\'f3\u1077\'e5\u1084\'ec\u1099\'fb\u1081\'e9 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1100\'fc \u1080\'e8\u1083\'eb\u1080\'e8 \u1089\'f1\u1086\'ee\u1073\'e1\u1088\'f0\u1072\'e0\u1085\'ed\u1085\'ed\u1099\'fb\u1081\'e9 \u1079\'e7\u1072\'e0\u1085\'ed\u1086\'ee\u1074\'e2\u1086\'ee \u1086\'ee\u1088\'f0\u1080\'e8\u1075\'e3\u1080\'e8\u1085\'ed\u1072\'e0\u1083\'eb \u8212\'97 \u1103\'ff\u1074\'e2\u1083\'eb\u1103\'ff\u1077\'e5\u1090\'f2\u1089\'f1\u1103\'ff \u171\'ab\u1085\'ed\u1072\'e0\u1089\'f1\u1090\'f2\u1086\'ee\u1103\'ff\u1097\'f9\u1080\'e8\u1084\'ec\u187\'bb \u1050\'ca\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1105\'b8\u1084\'ec \u1058\'d2\u1077\'e5\u1089\'f1\u1077\'e5\u1103\'ff? \u1057\'d1\u1082\'ea\u1072\'e0\u1079\'e7\u1072\'e0\u1090\'f2\u1100\'fc, \u1095\'f7\u1090\'f2\u1086\'ee \u1086\'ee\u1073\'e1\u1072\'e0, \u1085\'ed\u1077\'e5 \u1090\'f2\u1072\'e0\u1082\'ea \u1087\'ef\u1088\'f0\u1086\'ee\u1089\'f1\u1090\'f2\u1086\'ee.}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1056\'d0\u1072\'e0\u1079\'e7\u1085\'ed\u1099\'fb\u1077\'e5 \u1092\'f4\u1080\'e8\u1083\'eb\u1086\'ee\u1089\'f1\u1086\'ee\u1092\'f4\u1089\'f1\u1082\'ea\u1080\'e8\u1077\'e5 \u1086\'ee\u1090\'f2\u1074\'e2\u1077\'e5\u1090\'f2\u1099\'fb}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls13 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1055\'cf\u1077\'e5\u1088\'f0\u1077\'e5\u1082\'ea\u1088\'f0\u1077\'e5\u1089\'f1\u1090\'f2\u1080\'e8\u1079\'e7\u1084\'ec (perdurantism)}{\rtlch\ab0 \ltrch\loch\b0\loch
 \u8212\'97 \u1086\'ee\u1073\'e1\u1098\'fa\u1077\'e5\u1082\'ea\u1090\'f2\u1099\'fb \u1087\'ef\u1088\'f0\u1077\'e5\u1076\'e4\u1089\'f1\u1090\'f2\u1072\'e0\u1074\'e2\u1083\'eb\u1103\'ff\u1102\'fe\u1090\'f2 \u1089\'f1\u1086\'ee\u1073\'e1\u1086\'ee\u1081\'e9 \u1089\'f1\u1074\'e2\u1086\'ee\u1077\'e5\u1075\'e3\u1086\'ee \u1088\'f0\u1086\'ee\u1076\'e4\u1072\'e0 \u1095\'f7\u1077\'e5\u1090\'f2\u1099\'fb\u1088\'f0\u1105\'b8\u1093\'f5\u1084\'ec\u1077\'e5\u1088\'f0\u1085\'ed\u1099\'fb\u1093\'f5 \u171\'ab\u1095\'f7\u1077\'e5\u1088\'f0\u1074\'e2\u1077\'e5\u1081\'e9\u187\'bb, \u1088\'f0\u1072\'e0\u1089\'f1\u1090\'f2\u1103\'ff\u1085\'ed\u1091\'f3\u1090\'f2\u1099\'fb\u1093\'f5 \u1074\'e2\u1086\'ee \u1074\'e2\u1088\'f0\u1077\'e5\u1084\'ec\u1077\'e5\u1085\'ed\u1080\'e8; \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1100\'fc \u1074\'e2 \u1083\'eb\u1102\'fe\u1073\'e1\u1086\'ee\u1081\'e9 \u1084\'ec\u1086\'ee\u1084\'ec\u1077\'e5\u1085\'ed\u1090\'f2 \u8212\'97 \u1101\'fd\u1090\'f2\u1086\'ee \u1083\'eb\u1080\'e8\u1096\'f8\u1100\'fc \u1074\'e2\u1088\'f0\u1077\'e5\u1084\'ec\u1077\'e5\u1085\'ed\u1085\'ed\u1086\'ee\u1081\'e9 \u1089\'f1\u1088\'f0\u1077\'e5\u1079\'e7 \u1073\'e1\u1086\'ee\u1083\'eb\u1077\'e5\u1077\'e5 \u1076\'e4\u1083\'eb\u1080\'e8\u1085\'ed\u1085\'ed\u1086\'ee\u1081\'e9 \u1089\'f1\u1091\'f3\u1097\'f9\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1080\'e8. \u1057\'d1 \u1101\'fd\u1090\'f2\u1086\'ee\u1081\'e9 \u1090\'f2\u1086\'ee\u1095\'f7\u1082\'ea\u1080\'e8 \u1079\'e7\u1088\'f0\u1077\'e5\u1085\'ed\u1080\'e8\u1103\'ff \u1087\'ef\u1086\'ee\u1089\'f1\u1090\'f2\u1077\'e5\u1087\'ef\u1077\'e5\u1085\'ed\u1085\'ed\u1072\'e0\u1103\'ff \u1079\'e7\u1072\'e0\u1084\'ec\u1077\'e5\u1085\'ed\u1072\'e0 \u1085\'ed\u1077\'e5 \u1085\'ed\u1072\'e0\u1088\'f0\u1091\'f3\u1096\'f8\u1072\'e0\u1077\'e5\u1090\'f2 \u1090\'f2\u1086\'ee\u1078\'e6\u1076\'e4\u1077\'e5\u1089\'f1\u1090\'f2\u1074\'e2\u1086\'ee, \u1087\'ef\u1086\'ee\u1090\'f2\u1086\'ee\u1084\'ec\u1091\'f3 \u1095\'f7\u1090\'f2\u1086\'ee \u1090\'f2\u1086\'ee\u1078\'e6\u1076\'e4\u1077\'e5\u1089\'f1\u1090\'f2\u1074\'e2\u1086\'ee \u1089\'f1\u1074\'e2\u1103\'ff\u1079\'e7\u1072\'e0\u1085\'ed\u1086\'ee \u1085\'ed\u1077\'e5 \u1089\'f1 \u1082\'ea\u1086\'ee\u1085\'ed\u1082\'ea\u1088\'f0\u1077\'e5\u1090\'f2\u1085\'ed\u1099\'fb\u1084\'ec \u1085\'ed\u1072\'e0\u1073\'e1\u1086\'ee\u1088\'f0\u1086\'ee\u1084\'ec \u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1080\'e8\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1099\'fb\u1093\'f5 \u1095\'f7\u1072\'e0\u1089\'f1\u1090\'f2\u1077\'e5\u1081\'e9, \u1072\'e0 \u1089\'f1 \u1085\'ed\u1077\'e5\u1087\'ef\u1088\'f0\u1077\'e5\u1088\'f0\u1099\'fb\u1074\'e2\u1085\'ed\u1086\'ee\u1081\'e9 \u1087\'ef\u1088\'f0\u1080\'e8\u1095\'f7\u1080\'e8\u1085\'ed\u1085\'ed\u1086\'ee\u1081\'e9 \u1094\'f6\u1077\'e5\u1087\'ef\u1100\'fc\u1102\'fe \u1074\'e2 \u1087\'ef\u1088\'f0\u1086\'ee\u1089\'f1\u1090\'f2\u1088\'f0\u1072\'e0\u1085\'ed\u1089\'f1\u1090\'f2\u1074\'e2\u1077\'e5-\u1074\'e2\u1088\'f0\u1077\'e5\u1084\'ec\u1077\'e5\u1085\'ed\u1080\'e8. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls13 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1052\'cc\u1077\'e5\u1088\'f0\u1077\'e5\u1086\'ee\u1083\'eb\u1086\'ee\u1075\'e3\u1080\'e8\u1095\'f7\u1077\'e5\u1089\'f1\u1082\'ea\u1080\'e8\u1081\'e9 \u1101\'fd\u1089\'f1\u1089\'f1\u1077\'e5\u1085\'ed\u1094\'f6\u1080\'e8\u1072\'e0\u1083\'eb\u1080\'e8\u1079\'e7\u1084\'ec}{\rtlch\ab0 \ltrch\loch\b0\loch
 \u8212\'97 \u1090\'f2\u1086\'ee\u1078\'e6\u1076\'e4\u1077\'e5\u1089\'f1\u1090\'f2\u1074\'e2\u1086\'ee \u1086\'ee\u1073\'e1\u1098\'fa\u1077\'e5\u1082\'ea\u1090\'f2\u1072\'e0 \u1079\'e7\u1072\'e0\u1074\'e2\u1080\'e8\u1089\'f1\u1080\'e8\u1090\'f2 \u1086\'ee\u1090\'f2 \u1090\'f2\u1086\'ee\u1075\'e3\u1086\'ee, \u1086\'ee\u1073\'e1\u1083\'eb\u1072\'e0\u1076\'e4\u1072\'e0\u1077\'e5\u1090\'f2 \u1083\'eb\u1080\'e8 \u1086\'ee\u1085\'ed \u1090\'f2\u1077\'e5\u1084\'ec\u1080\'e8 \u1078\'e6\u1077\'e5 \u1089\'f1\u1072\'e0\u1084\'ec\u1099\'fb\u1084\'ec\u1080\'e8 \u1095\'f7\u1072\'e0\u1089\'f1\u1090\'f2\u1103\'ff\u1084\'ec\u1080\'e8. \u1057\'d1 \u1101\'fd\u1090\'f2\u1086\'ee\u1081\'e9 \u1089\'f1\u1090\'f2\u1088\'f0\u1086\'ee\u1075\'e3\u1086\'ee\u1081\'e9 \u1087\'ef\u1086\'ee\u1079\'e7\u1080\'e8\u1094\'f6\u1080\'e8\u1080\'e8, \u1079\'e7\u1072\'e0\u1084\'ec\u1077\'e5\u1085\'ed\u1080\'e8\u1074\'e2 \u1093\'f5\u1086\'ee\u1090\'f2\u1103\'ff \u1073\'e1\u1099\'fb \u1086\'ee\u1076\'e4\u1085\'ed\u1091\'f3 \u1076\'e4\u1086\'ee\u1089\'f1\u1082\'ea\u1091\'f3, \u1074\'e2\u1099\'fb \u1090\'f2\u1077\'e5\u1093\'f5\u1085\'ed\u1080\'e8\u1095\'f7\u1077\'e5\u1089\'f1\u1082\'ea\u1080\'e8 \u1087\'ef\u1086\'ee\u1083\'eb\u1091\'f3\u1095\'f7\u1072\'e0\u1077\'e5\u1090\'f2\u1077\'e5 }{\rtlch\ab0 \ltrch\loch\cs43\rtlch\ai \ltrch\loch\i\b0\loch
\u1076\'e4\u1088\'f0\u1091\'f3\u1075\'e3\u1086\'ee\u1081\'e9}{\rtlch\ab0 \ltrch\loch\b0\loch
 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1100\'fc (\u1080\'e8\u1083\'eb\u1080\'e8, \u1087\'ef\u1086\'ee \u1082\'ea\u1088\'f0\u1072\'e0\u1081\'e9\u1085\'ed\u1077\'e5\u1081\'e9 \u1084\'ec\u1077\'e5\u1088\'f0\u1077\'e5, \u1076\'e4\u1088\'f0\u1091\'f3\u1075\'e3\u1086\'ee\u1081\'e9 \u1086\'ee\u1073\'e1\u1098\'fa\u1077\'e5\u1082\'ea\u1090\'f2), \u1076\'e4\u1072\'e0\u1078\'e6\u1077\'e5 \u1077\'e5\u1089\'f1\u1083\'eb\u1080\'e8 \u1087\'ef\u1086\'ee \u1087\'ef\u1088\'f0\u1080\'e8\u1074\'e2\u1099\'fb\u1095\'f7\u1082\'ea\u1077\'e5 \u1087\'ef\u1088\'f0\u1086\'ee\u1076\'e4\u1086\'ee\u1083\'eb\u1078\'e6\u1072\'e0\u1077\'e5\u1084\'ec \u1085\'ed\u1072\'e0\u1079\'e7\u1099\'fb\u1074\'e2\u1072\'e0\u1090\'f2\u1100\'fc \u1077\'e5\u1075\'e3\u1086\'ee \u171\'ab\u1090\'f2\u1077\'e5\u1084\'ec \u1078\'e6\u1077\'e5 \u1089\'f1\u1072\'e0\u1084\'ec\u1099\'fb\u1084\'ec\u187\'bb. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls13 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1058\'d2\u1077\'e5\u1086\'ee\u1088\'f0\u1080\'e8\u1103\'ff \u1089\'f1\u1074\'e2\u1103\'ff\u1079\'e7\u1086\'ee\u1082\'ea / \u1088\'f0\u1077\'e5\u1083\'eb\u1103\'ff\u1094\'f6\u1080\'e8\u1086\'ee\u1085\'ed\u1085\'ed\u1086\'ee\u1077\'e5 \u1090\'f2\u1086\'ee\u1078\'e6\u1076\'e4\u1077\'e5\u1089\'f1\u1090\'f2\u1074\'e2\u1086\'ee}{\rtlch\ab0 \ltrch\loch\b0\loch
 \u8212\'97 \u1090\'f2\u1086\'ee, \u1095\'f7\u1090\'f2\u1086\'ee \u1076\'e4\u1077\'e5\u1083\'eb\u1072\'e0\u1077\'e5\u1090\'f2 \u1085\'ed\u1077\'e5\u1095\'f7\u1090\'f2\u1086\'ee \u171\'ab\u1090\'f2\u1077\'e5\u1084\'ec \u1078\'e6\u1077\'e5 \u1089\'f1\u1072\'e0\u1084\'ec\u1099\'fb\u1084\'ec \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1105\'b8\u1084\'ec\u187\'bb, \u1101\'fd\u1090\'f2\u1086\'ee \u1085\'ed\u1077\'e5 \u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1080\'e8\u1072\'e0\u1083\'eb, \u1072\'e0 \u1089\'f1\u1086\'ee\u1093\'f5\u1088\'f0\u1072\'e0\u1085\'ed\u1077\'e5\u1085\'ed\u1080\'e8\u1077\'e5 \u1089\'f1\u1090\'f2\u1088\'f0\u1091\'f3\u1082\'ea\u1090\'f2\u1091\'f3\u1088\'f0\u1099\'fb, \u1092\'f4\u1091\'f3\u1085\'ed\u1082\'ea\u1094\'f6\u1080\'e8\u1080\'e8 \u1080\'e8 \u1092\'f4\u1086\'ee\u1088\'f0\u1084\'ec\u1099\'fb \u8212\'97 \u1090\'f2\u1072\'e0 \u1078\'e6\u1077\'e5 \u1092\'f4\u1086\'ee\u1088\'f0\u1084\'ec\u1072\'e0, \u1090\'f2\u1072\'e0 \u1078\'e6\u1077\'e5 \u1094\'f6\u1077\'e5\u1083\'eb\u1100\'fc, \u1090\'f2\u1072\'e0 \u1078\'e6\u1077\'e5 \u1085\'ed\u1077\'e5\u1087\'ef\u1088\'f0\u1077\'e5\u1088\'f0\u1099\'fb\u1074\'e2\u1085\'ed\u1072\'e0\u1103\'ff \u1080\'e8\u1089\'f1\u1090\'f2\u1086\'ee\u1088\'f0\u1080\'e8\u1103\'ff \u1080\'e8\u1089\'f1\u1087\'ef\u1086\'ee\u1083\'eb\u1100\'fc\u1079\'e7\u1086\'ee\u1074\'e2\u1072\'e0\u1085\'ed\u1080\'e8\u1103\'ff. \u1057\'d1 \u1101\'fd\u1090\'f2\u1086\'ee\u1081\'e9 \u1090\'f2\u1086\'ee\u1095\'f7\u1082\'ea\u1080\'e8 \u1079\'e7\u1088\'f0\u1077\'e5\u1085\'ed\u1080\'e8\u1103\'ff \u1086\'ee\u1090\'f2\u1088\'f0\u1077\'e5\u1084\'ec\u1086\'ee\u1085\'ed\u1090\'f2\u1080\'e8\u1088\'f0\u1086\'ee\u1074\'e2\u1072\'e0\u1085\'ed\u1085\'ed\u1099\'fb\u1081\'e9 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1100\'fc \u1089\'f1\u1095\'f7\u1080\'e8\u1090\'f2\u1072\'e0\u1077\'e5\u1090\'f2\u1089\'f1\u1103\'ff \u1090\'f2\u1077\'e5\u1084\'ec \u1078\'e6\u1077\'e5 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1105\'b8\u1084\'ec, \u1087\'ef\u1086\'ee\u1090\'f2\u1086\'ee\u1084\'ec\u1091\'f3 \u1095\'f7\u1090\'f2\u1086\'ee \u1087\'ef\u1072\'e0\u1090\'f2\u1090\'f2\u1077\'e5\u1088\'f0\u1085\'ed \u1089\'f1\u1086\'ee\u1093\'f5\u1088\'f0\u1072\'e0\u1085\'ed\u1080\'e8\u1083\'eb\u1089\'f1\u1103\'ff, \u1076\'e4\u1072\'e0\u1078\'e6\u1077\'e5 \u1082\'ea\u1086\'ee\u1075\'e3\u1076\'e4\u1072\'e0 \u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1080\'e8\u1072\'e0\u1083\'eb \u1087\'ef\u1086\'ee\u1083\'eb\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1100\'fc\u1102\'fe \u1089\'f1\u1084\'ec\u1077\'e5\u1085\'ed\u1080\'e8\u1083\'eb\u1089\'f1\u1103\'ff \u8212\'97 \u1087\'ef\u1086\'ee\u1076\'e4\u1086\'ee\u1073\'e1\u1085\'ed\u1086\'ee \u1090\'f2\u1086\'ee\u1084\'ec\u1091\'f3, \u1082\'ea\u1072\'e0\u1082\'ea \u1088\'f0\u1077\'e5\u1082\'ea\u1072\'e0 \u1086\'ee\u1089\'f1\u1090\'f2\u1072\'e0\u1105\'b8\u1090\'f2\u1089\'f1\u1103\'ff \u171\'ab\u1090\'f2\u1086\'ee\u1081\'e9 \u1078\'e6\u1077\'e5 \u1088\'f0\u1077\'e5\u1082\'ea\u1086\'ee\u1081\'e9\u187\'bb, \u1093\'f5\u1086\'ee\u1090\'f2\u1103\'ff \u1074\'e2\u1086\'ee\u1076\'e4\u1072\'e0 \u1074\'e2 \u1085\'ed\u1077\'e5\u1081\'e9 \u1087\'ef\u1086\'ee\u1089\'f1\u1090\'f2\u1086\'ee\u1103\'ff\u1085\'ed\u1085\'ed\u1086\'ee \u1090\'f2\u1077\'e5\u1095\'f7\u1105\'b8\u1090\'f2 \u1080\'e8 \u1089\'f1\u1084\'ec\u1077\'e5\u1085\'ed\u1103\'ff\u1077\'e5\u1090\'f2\u1089\'f1\u1103\'ff. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls13 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1050\'ca\u1086\'ee\u1085\'ed\u1074\'e2\u1077\'e5\u1085\'ed\u1094\'f6\u1080\'e8\u1086\'ee\u1085\'ed\u1072\'e0\u1083\'eb\u1080\'e8\u1079\'e7\u1084\'ec}{\rtlch\ab0 \ltrch\loch\b0\loch
 \u8212\'97 \u1085\'ed\u1080\'e8\u1082\'ea\u1072\'e0\u1082\'ea\u1086\'ee\u1075\'e3\u1086\'ee \u1086\'ee\u1073\'e1\u1098\'fa\u1077\'e5\u1082\'ea\u1090\'f2\u1080\'e8\u1074\'e2\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1092\'f4\u1072\'e0\u1082\'ea\u1090\'f2\u1072\'e0 \u1079\'e7\u1076\'e4\u1077\'e5\u1089\'f1\u1100\'fc \u1074\'e2\u1086\'ee\u1086\'ee\u1073\'e1\u1097\'f9\u1077\'e5 \u1085\'ed\u1077\'e5\u1090\'f2. \u171\'ab\u1058\'d2\u1086\'ee\u1090\'f2 \u1078\'e6\u1077\'e5 \u1089\'f1\u1072\'e0\u1084\'ec\u1099\'fb\u1081\'e9 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1100\'fc\u187\'bb \u8212\'97 \u1085\'ed\u1077\'e5 \u1075\'e3\u1083\'eb\u1091\'f3\u1073\'e1\u1086\'ee\u1082\'ea\u1072\'e0\u1103\'ff \u1084\'ec\u1077\'e5\u1090\'f2\u1072\'e0\u1092\'f4\u1080\'e8\u1079\'e7\u1080\'e8\u1095\'f7\u1077\'e5\u1089\'f1\u1082\'ea\u1072\'e0\u1103\'ff \u1080\'e8\u1089\'f1\u1090\'f2\u1080\'e8\u1085\'ed\u1072\'e0, \u1082\'ea\u1086\'ee\u1090\'f2\u1086\'ee\u1088\'f0\u1091\'f3\u1102\'fe \u1085\'ed\u1091\'f3\u1078\'e6\u1085\'ed\u1086\'ee \u1086\'ee\u1090\'f2\u1082\'ea\u1088\'f0\u1099\'fb\u1090\'f2\u1100\'fc, \u1072\'e0 \u1103\'ff\u1079\'e7\u1099\'fb\u1082\'ea\u1086\'ee\u1074\'e2\u1072\'e0\u1103\'ff/\u1089\'f1\u1086\'ee\u1094\'f6\u1080\'e8\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1072\'e0\u1103\'ff \u1076\'e4\u1086\'ee\u1075\'e3\u1086\'ee\u1074\'e2\u1086\'ee\u1088\'f0\u1105\'b8\u1085\'ed\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1100\'fc. \u1052\'cc\u1099\'fb \u1088\'f0\u1077\'e5\u1096\'f8\u1072\'e0\u1077\'e5\u1084\'ec, \u1095\'f7\u1090\'f2\u1086\'ee \u1089\'f1\u1095\'f7\u1080\'e8\u1090\'f2\u1072\'e0\u1090\'f2\u1100\'fc \u171\'ab\u1090\'f2\u1077\'e5\u1084\'ec \u1078\'e6\u1077\'e5 \u1089\'f1\u1072\'e0\u1084\'ec\u1099\'fb\u1084\'ec\u187\'bb, \u1080\'e8\u1089\'f1\u1093\'f5\u1086\'ee\u1076\'e4\u1103\'ff \u1080\'e8\u1079\'e7 \u1087\'ef\u1088\'f0\u1072\'e0\u1082\'ea\u1090\'f2\u1080\'e8\u1095\'f7\u1077\'e5\u1089\'f1\u1082\'ea\u1080\'e8\u1093\'f5 \u1094\'f6\u1077\'e5\u1083\'eb\u1077\'e5\u1081\'e9 (\u1087\'ef\u1088\'f0\u1072\'e0\u1074\'e2\u1086\'ee \u1089\'f1\u1086\'ee\u1073\'e1\u1089\'f1\u1090\'f2\u1074\'e2\u1077\'e5\u1085\'ed\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1080\'e8, \u1080\'e8\u1089\'f1\u1090\'f2\u1086\'ee\u1088\'f0\u1080\'e8\u1095\'f7\u1077\'e5\u1089\'f1\u1082\'ea\u1072\'e0\u1103\'ff \u1087\'ef\u1088\'f0\u1077\'e5\u1077\'e5\u1084\'ec\u1089\'f1\u1090\'f2\u1074\'e2\u1077\'e5\u1085\'ed\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1100\'fc \u1080\'e8 \u1090\'f2.\u1076\'e4.), \u1080\'e8 \u1088\'f0\u1072\'e0\u1079\'e7\u1085\'ed\u1099\'fb\u1077\'e5 \u1094\'f6\u1077\'e5\u1083\'eb\u1080\'e8 \u1074\'e2\u1087\'ef\u1086\'ee\u1083\'eb\u1085\'ed\u1077\'e5 \u1084\'ec\u1086\'ee\u1075\'e3\u1091\'f3\u1090\'f2 \u1076\'e4\u1072\'e0\u1074\'e2\u1072\'e0\u1090\'f2\u1100\'fc \u1088\'f0\u1072\'e0\u1079\'e7\u1085\'ed\u1099\'fb\u1077\'e5 \u1086\'ee\u1090\'f2\u1074\'e2\u1077\'e5\u1090\'f2\u1099\'fb. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1055\'cf\u1086\'ee\u1095\'f7\u1077\'e5\u1084\'ec\u1091\'f3 \u1101\'fd\u1090\'f2\u1086\'ee \u1074\'e2\u1072\'e0\u1078\'e6\u1085\'ed\u1086\'ee \u1085\'ed\u1077\'e5 \u1090\'f2\u1086\'ee\u1083\'eb\u1100\'fc\u1082\'ea\u1086\'ee \u1076\'e4\u1083\'eb\u1103\'ff \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1077\'e5\u1081\'e9}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1069\'dd\u1090\'f2\u1086\'ee \u1085\'ed\u1077\'e5 \u1087\'ef\u1088\'f0\u1086\'ee\u1089\'f1\u1090\'f2\u1086\'ee \u1084\'ec\u1099\'fb\u1089\'f1\u1083\'eb\u1077\'e5\u1085\'ed\u1085\'ed\u1099\'fb\u1081\'e9 \u1101\'fd\u1082\'ea\u1089\'f1\u1087\'ef\u1077\'e5\u1088\'f0\u1080\'e8\u1084\'ec\u1077\'e5\u1085\'ed\u1090\'f2 \u1088\'f0\u1072\'e0\u1076\'e4\u1080\'e8 \u1089\'f1\u1072\'e0\u1084\'ec\u1086\'ee\u1075\'e3\u1086\'ee \u1089\'f1\u1077\'e5\u1073\'e1\u1103\'ff \u8212\'97 \u1101\'fd\u1090\'f2\u1086\'ee \u1084\'ec\u1086\'ee\u1076\'e4\u1077\'e5\u1083\'eb\u1100\'fc \u1076\'e4\u1083\'eb\u1103\'ff \u1074\'e2\u1086\'ee\u1087\'ef\u1088\'f0\u1086\'ee\u1089\'f1\u1086\'ee\u1074\'e2 \u1086\'ee \u1090\'f2\u1086\'ee\u1078\'e6\u1076\'e4\u1077\'e5\u1089\'f1\u1090\'f2\u1074\'e2\u1077\'e5, \u1082\'ea\u1086\'ee\u1090\'f2\u1086\'ee\u1088\'f0\u1099\'fb\u1077\'e5 \u1087\'ef\u1088\'f0\u1080\'e8\u1084\'ec\u1077\'e5\u1085\'ed\u1080\'e8\u1084\'ec\u1099\'fb \u1074\'e2\u1077\'e5\u1079\'e7\u1076\'e4\u1077\'e5:}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls14 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1042\'c2\u1072\'e0\u1096\'f8\u1077\'e5 \u1090\'f2\u1077\'e5\u1083\'eb\u1086\'ee \u1079\'e7\u1072\'e0\u1084\'ec\u1077\'e5\u1085\'ed\u1103\'ff\u1077\'e5\u1090\'f2 \u1087\'ef\u1086\'ee\u1095\'f7\u1090\'f2\u1080\'e8 \u1074\'e2\u1089\'f1\u1077\'e5 \u1089\'f1\u1074\'e2\u1086\'ee\u1080\'e8 \u1082\'ea\u1083\'eb\u1077\'e5\u1090\'f2\u1082\'ea\u1080\'e8 \u1087\'ef\u1088\'f0\u1080\'e8\u1084\'ec\u1077\'e5\u1088\'f0\u1085\'ed\u1086\'ee \u1079\'e7\u1072\'e0 7\u8211\'9610 \u1083\'eb\u1077\'e5\u1090\'f2 \u8212\'97 \u1074\'e2\u1099\'fb \u171\'ab\u1090\'f2\u1086\'ee\u1090\'f2 \u1078\'e6\u1077\'e5 \u1095\'f7\u1077\'e5\u1083\'eb\u1086\'ee\u1074\'e2\u1077\'e5\u1082\'ea\u187\'bb, \u1082\'ea\u1072\'e0\u1082\'ea\u1080\'e8\u1084\'ec \u1073\'e1\u1099\'fb\u1083\'eb\u1080\'e8 \u1076\'e4\u1077\'e5\u1089\'f1\u1103\'ff\u1090\'f2\u1100\'fc \u1083\'eb\u1077\'e5\u1090\'f2 \u1085\'ed\u1072\'e0\u1079\'e7\u1072\'e0\u1076\'e4? }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls14 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1042\'c2\u1086\'ee\u1076\'e4\u1072\'e0 \u1074\'e2 \u1088\'f0\u1077\'e5\u1082\'ea\u1077\'e5 \u1085\'ed\u1080\'e8\u1082\'ea\u1086\'ee\u1075\'e3\u1076\'e4\u1072\'e0 \u1085\'ed\u1077\'e5 \u1086\'ee\u1076\'e4\u1085\'ed\u1072\'e0 \u1080\'e8 \u1090\'f2\u1072\'e0 \u1078\'e6\u1077\'e5 \u1076\'e4\u1074\'e2\u1072\'e0\u1078\'e6\u1076\'e4\u1099\'fb, \u1086\'ee\u1076\'e4\u1085\'ed\u1072\'e0\u1082\'ea\u1086\'ee \u1084\'ec\u1099\'fb \u1085\'ed\u1072\'e0\u1079\'e7\u1099\'fb\u1074\'e2\u1072\'e0\u1077\'e5\u1084\'ec \u1077\'e5\u1105\'b8 \u1086\'ee\u1076\'e4\u1085\'ed\u1086\'ee\u1081\'e9 \u1080\'e8 \u1090\'f2\u1086\'ee\u1081\'e9 \u1078\'e6\u1077\'e5 \u1088\'f0\u1077\'e5\u1082\'ea\u1086\'ee\u1081\'e9. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls14 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1050\'ca\u1086\'ee\u1084\'ec\u1087\'ef\u1072\'e0\u1085\'ed\u1080\'e8\u1103\'ff \u1084\'ec\u1086\'ee\u1078\'e6\u1077\'e5\u1090\'f2 \u1087\'ef\u1086\'ee\u1083\'eb\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1100\'fc\u1102\'fe \u1089\'f1\u1084\'ec\u1077\'e5\u1085\'ed\u1080\'e8\u1090\'f2\u1100\'fc \u1074\'e2\u1089\'f1\u1077\'e5\u1093\'f5 \u1089\'f1\u1086\'ee\u1090\'f2\u1088\'f0\u1091\'f3\u1076\'e4\u1085\'ed\u1080\'e8\u1082\'ea\u1086\'ee\u1074\'e2 \u1080\'e8 \u1074\'e2\u1089\'f1\u1105\'b8 \u1078\'e6\u1077\'e5 \u1089\'f1\u1095\'f7\u1080\'e8\u1090\'f2\u1072\'e0\u1090\'f2\u1100\'fc\u1089\'f1\u1103\'ff \u171\'ab\u1090\'f2\u1086\'ee\u1081\'e9 \u1078\'e6\u1077\'e5\u187\'bb \u1086\'ee\u1088\'f0\u1075\'e3\u1072\'e0\u1085\'ed\u1080\'e8\u1079\'e7\u1072\'e0\u1094\'f6\u1080\'e8\u1077\'e5\u1081\'e9. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls14 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1055\'cf\u1088\'f0\u1086\'ee\u1075\'e3\u1088\'f0\u1072\'e0\u1084\'ec\u1084\'ec\u1085\'ed\u1086\'ee\u1077\'e5 \u1086\'ee\u1073\'e1\u1077\'e5\u1089\'f1\u1087\'ef\u1077\'e5\u1095\'f7\u1077\'e5\u1085\'ed\u1080\'e8\u1077\'e5 \u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1087\'ef\u1080\'e8\u1089\'f1\u1099\'fb\u1074\'e2\u1072\'e0\u1077\'e5\u1090\'f2\u1089\'f1\u1103\'ff \u1084\'ec\u1086\'ee\u1076\'e4\u1091\'f3\u1083\'eb\u1100\'fc \u1079\'e7\u1072\'e0 \u1084\'ec\u1086\'ee\u1076\'e4\u1091\'f3\u1083\'eb\u1077\'e5\u1084\'ec \u8212\'97 \u1074\'e2 \u1082\'ea\u1072\'e0\u1082\'ea\u1086\'ee\u1081\'e9 \u1084\'ec\u1086\'ee\u1084\'ec\u1077\'e5\u1085\'ed\u1090\'f2 \u1101\'fd\u1090\'f2\u1086\'ee \u1091\'f3\u1078\'e6\u1077\'e5 \u1085\'ed\u1086\'ee\u1074\'e2\u1072\'e0\u1103\'ff \u1087\'ef\u1088\'f0\u1086\'ee\u1075\'e3\u1088\'f0\u1072\'e0\u1084\'ec\u1084\'ec\u1072\'e0? }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1055\'cf\u1086\'ee\u1083\'eb\u1077\'e5\u1079\'e7\u1085\'ed\u1099\'fb\u1081\'e9 \u1089\'f1\u1087\'ef\u1086\'ee\u1089\'f1\u1086\'ee\u1073\'e1 \u1086\'ee\u1089\'f1\u1084\'ec\u1099\'fb\u1089\'f1\u1083\'eb\u1080\'e8\u1090\'f2\u1100\'fc \u1101\'fd\u1090\'f2\u1086\'ee}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1056\'d0\u1072\'e0\u1089\'f1\u1087\'ef\u1088\'f0\u1086\'ee\u1089\'f1\u1090\'f2\u1088\'f0\u1072\'e0\u1085\'ed\u1105\'b8\u1085\'ed\u1085\'ed\u1072\'e0\u1103\'ff \u1089\'f1\u1086\'ee\u1074\'e2\u1088\'f0\u1077\'e5\u1084\'ec\u1077\'e5\u1085\'ed\u1085\'ed\u1072\'e0\u1103\'ff \u1090\'f2\u1086\'ee\u1095\'f7\u1082\'ea\u1072\'e0 \u1079\'e7\u1088\'f0\u1077\'e5\u1085\'ed\u1080\'e8\u1103\'ff: \u1090\'f2\u1086\'ee\u1078\'e6\u1076\'e4\u1077\'e5\u1089\'f1\u1090\'f2\u1074\'e2\u1086\'ee \u1074\'e2\u1086\'ee \u1074\'e2\u1088\'f0\u1077\'e5\u1084\'ec\u1077\'e5\u1085\'ed\u1080\'e8 \u8212\'97 \u1101\'fd\u1090\'f2\u1086\'ee \u1085\'ed\u1077\'e5 \u1086\'ee \u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1080\'e8\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1086\'ee\u1081\'e9 \u1080\'e8\u1076\'e4\u1077\'e5\u1085\'ed\u1090\'f2\u1080\'e8\u1095\'f7\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1080\'e8, \u1072\'e0 \u1086\'ee \u1085\'ed\u1077\'e5\u1087\'ef\u1088\'f0\u1077\'e5\u1088\'f0\u1099\'fb\u1074\'e2\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1080\'e8 \u8212\'97 \u1085\'ed\u1077\'e5\u1088\'f0\u1072\'e0\u1079\'e7\u1088\'f0\u1099\'fb\u1074\'e2\u1085\'ed\u1086\'ee\u1081\'e9 \u1094\'f6\u1077\'e5\u1087\'ef\u1086\'ee\u1095\'f7\u1082\'ea\u1077\'e5 \u1087\'ef\u1086\'ee\u1089\'f1\u1090\'f2\u1077\'e5\u1087\'ef\u1077\'e5\u1085\'ed\u1085\'ed\u1099\'fb\u1093\'f5 \u1080\'e8\u1079\'e7\u1084\'ec\u1077\'e5\u1085\'ed\u1077\'e5\u1085\'ed\u1080\'e8\u1081\'e9, \u1075\'e3\u1076\'e4\u1077\'e5 \u1085\'ed\u1072\'e0 \u1082\'ea\u1072\'e0\u1078\'e6\u1076\'e4\u1086\'ee\u1084\'ec \u1096\'f8\u1072\'e0\u1075\'e3\u1077\'e5 \u1076\'e4\u1086\'ee\u1089\'f1\u1090\'f2\u1072\'e0\u1090\'f2\u1086\'ee\u1095\'f7\u1085\'ed\u1086\'ee \u1089\'f1\u1086\'ee\u1074\'e2\u1087\'ef\u1072\'e0\u1076\'e4\u1077\'e5\u1085\'ed\u1080\'e8\u1103\'ff \u1089\'f1 \u1087\'ef\u1088\'f0\u1077\'e5\u1076\'e4\u1099\'fb\u1076\'e4\u1091\'f3\u1097\'f9\u1080\'e8\u1084\'ec \u1089\'f1\u1086\'ee\u1089\'f1\u1090\'f2\u1086\'ee\u1103\'ff\u1085\'ed\u1080\'e8\u1077\'e5\u1084\'ec, \u1095\'f7\u1090\'f2\u1086\'ee\u1073\'e1\u1099\'fb \u1084\'ec\u1099\'fb \u1073\'e1\u1099\'fb\u1083\'eb\u1080\'e8 \u1075\'e3\u1086\'ee\u1090\'f2\u1086\'ee\u1074\'e2\u1099\'fb \u1089\'f1\u1082\'ea\u1072\'e0\u1079\'e7\u1072\'e0\u1090\'f2\u1100\'fc: \u171\'ab\u1076\'e4\u1072\'e0, \u1101\'fd\u1090\'f2\u1086\'ee \u1074\'e2\u1089\'f1\u1105\'b8 \u1077\'e5\u1097\'f9\u1105\'b8 \u1086\'ee\u1085\'ed\u1086\'ee\u187\'bb. \u1055\'cf\u1072\'e0\u1088\'f0\u1072\'e0\u1076\'e4\u1086\'ee\u1082\'ea\u1089\'f1 \u1074\'e2\u1086\'ee\u1079\'e7\u1085\'ed\u1080\'e8\u1082\'ea\u1072\'e0\u1077\'e5\u1090\'f2 \u1080\'e8\u1084\'ec\u1077\'e5\u1085\'ed\u1085\'ed\u1086\'ee \u1090\'f2\u1086\'ee\u1075\'e3\u1076\'e4\u1072\'e0, \u1082\'ea\u1086\'ee\u1075\'e3\u1076\'e4\u1072\'e0 }{\rtlch\ab0 \ltrch\loch\cs43\rtlch\ai \ltrch\loch\i\b0\loch
\u1086\'ee\u1088\'f0\u1080\'e8\u1075\'e3\u1080\'e8\u1085\'ed\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1099\'fb\u1081\'e9 \u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1080\'e8\u1072\'e0\u1083\'eb}{\rtlch\ab0 \ltrch\loch\b0\loch
 \u1089\'f1\u1086\'ee\u1073\'e1\u1080\'e8\u1088\'f0\u1072\'e0\u1102\'fe\u1090\'f2 \u1079\'e7\u1072\'e0\u1085\'ed\u1086\'ee\u1074\'e2\u1086\'ee \u1086\'ee\u1090\'f2\u1076\'e4\u1077\'e5\u1083\'eb\u1100\'fc\u1085\'ed\u1086\'ee, \u1087\'ef\u1086\'ee\u1090\'f2\u1086\'ee\u1084\'ec\u1091\'f3 \u1095\'f7\u1090\'f2\u1086\'ee \u1101\'fd\u1090\'f2\u1086\'ee \u1089\'f1\u1086\'ee\u1079\'e7\u1076\'e4\u1072\'e0\u1105\'b8\u1090\'f2 \u1076\'e4\u1074\'e2\u1072\'e0 \u1086\'ee\u1073\'e1\u1098\'fa\u1077\'e5\u1082\'ea\u1090\'f2\u1072\'e0, \u1082\'ea\u1072\'e0\u1078\'e6\u1076\'e4\u1099\'fb\u1081\'e9 \u1080\'e8\u1079\'e7 \u1082\'ea\u1086\'ee\u1090\'f2\u1086\'ee\u1088\'f0\u1099\'fb\u1093\'f5 \u1080\'e8\u1084\'ec\u1077\'e5\u1077\'e5\u1090\'f2 \u1079\'e7\u1072\'e0\u1082\'ea\u1086\'ee\u1085\'ed\u1085\'ed\u1086\'ee\u1077\'e5 \u1087\'ef\u1088\'f0\u1072\'e0\u1074\'e2\u1086\'ee \u1085\'ed\u1072\'e0 \u1085\'ed\u1077\'e5\u1087\'ef\u1088\'f0\u1077\'e5\u1088\'f0\u1099\'fb\u1074\'e2\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1100\'fc, \u1085\'ed\u1086\'ee \u1095\'f7\u1077\'e5\u1088\'f0\u1077\'e5\u1079\'e7 \u1088\'f0\u1072\'e0\u1079\'e7\u1085\'ed\u1099\'fb\u1077\'e5 \u1085\'ed\u1080\'e8\u1090\'f2\u1080\'e8 (\u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1080\'e8\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1091\'f3\u1102\'fe \u1085\'ed\u1077\'e5\u1087\'ef\u1088\'f0\u1077\'e5\u1088\'f0\u1099\'fb\u1074\'e2\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1100\'fc \u1087\'ef\u1088\'f0\u1086\'ee\u1090\'f2\u1080\'e8\u1074\'e2 \u1089\'f1\u1090\'f2\u1088\'f0\u1091\'f3\u1082\'ea\u1090\'f2\u1091\'f3\u1088\'f0\u1085\'ed\u1086\'ee\u1081\'e9/\u1092\'f4\u1091\'f3\u1085\'ed\u1082\'ea\u1094\'f6\u1080\'e8\u1086\'ee\u1085\'ed\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1086\'ee\u1081\'e9).}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ql\tx0\li0\ri0\lin0\rin0\fi0\ltrpar{\rtlch\afs22\ab0 \ltrch\loch\fs22\b0\loch
\u1045\'c5\u1076\'e4\u1080\'e8\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1082\'ea\u1086\'ee\u1085\'ed\u1089\'f1\u1077\'e5\u1085\'ed\u1089\'f1\u1091\'f3\u1089\'f1\u1072\'e0 \u1085\'ed\u1077\'e5\u1090\'f2 \u8212\'97 \u1080\'e8 \u1080\'e8\u1084\'ec\u1077\'e5\u1085\'ed\u1085\'ed\u1086\'ee \u1101\'fd\u1090\'f2\u1086\'ee \u1076\'e4\u1077\'e5\u1083\'eb\u1072\'e0\u1077\'e5\u1090\'f2 \u1087\'ef\u1072\'e0\u1088\'f0\u1072\'e0\u1076\'e4\u1086\'ee\u1082\'ea\u1089\'f1 \u1093\'f5\u1086\'ee\u1088\'f0\u1086\'ee\u1096\'f8\u1077\'e5\u1081\'e9 \u1092\'f4\u1080\'e8\u1083\'eb\u1086\'ee\u1089\'f1\u1086\'ee\u1092\'f4\u1089\'f1\u1082\'ea\u1086\'ee\u1081\'e9 \u1087\'ef\u1088\'f0\u1086\'ee\u1073\'e1\u1083\'eb\u1077\'e5\u1084\'ec\u1086\'ee\u1081\'e9, \u1072\'e0 \u1085\'ed\u1077\'e5 \u1088\'f0\u1077\'e5\u1096\'f8\u1105\'b8\u1085\'ed\u1085\'ed\u1086\'ee\u1081\'e9 \u1079\'e7\u1072\'e0\u1076\'e4\u1072\'e0\u1095\'f7\u1077\'e5\u1081\'e9. \u1061\'d5\u1086\'ee\u1090\'f2\u1080\'e8\u1090\'f2\u1077\'e5, \u1103\'ff \u1088\'f0\u1072\'e0\u1089\'f1\u1089\'f1\u1082\'ea\u1072\'e0\u1078\'e6\u1091\'f3, \u1082\'ea\u1072\'e0\u1082\'ea \u1101\'fd\u1090\'f2\u1086\'ee \u1089\'f1\u1074\'e2\u1103\'ff\u1079\'e7\u1072\'e0\u1085\'ed\u1086\'ee \u1089\'f1 \u1090\'f2\u1077\'e5\u1086\'ee\u1088\'f0\u1080\'e8\u1103\'ff\u1084\'ec\u1080\'e8 \u1083\'eb\u1080\'e8\u1095\'f7\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1090\'f2\u1086\'ee\u1078\'e6\u1076\'e4\u1077\'e5\u1089\'f1\u1090\'f2\u1074\'e2\u1072\'e0 (\u1085\'ed\u1072\'e0\u1087\'ef\u1088\'f0\u1080\'e8\u1084\'ec\u1077\'e5\u1088\'f0, \u1088\'f0\u1072\'e0\u1073\'e1\u1086\'ee\u1090\'f2\u1072\'e0\u1084\'ec\u1080\'e8 \u1044\'c4\u1077\'e5\u1088\'f0\u1077\'e5\u1082\'ea\u1072\'e0 \u1055\'cf\u1072\'e0\u1088\'f0\u1092\'f4\u1080\'e8\u1090\'f2\u1072\'e0), \u1080\'e8\u1083\'eb\u1080\'e8 \u1087\'ef\u1088\'f0\u1080\'e8\u1084\'ec\u1077\'e5\u1085\'ed\u1102\'fe \u1101\'fd\u1090\'f2\u1086\'ee \u1082\'ea \u1073\'e1\u1086\'ee\u1083\'eb\u1077\'e5\u1077\'e5 \u1089\'f1\u1086\'ee\u1074\'e2\u1088\'f0\u1077\'e5\u1084\'ec\u1077\'e5\u1085\'ed\u1085\'ed\u1086\'ee\u1084\'ec\u1091\'f3 \u1089\'f1\u1083\'eb\u1091\'f3\u1095\'f7\u1072\'e0\u1102\'fe?}
\par \pard\plain \s0\rtlch\af11\afs24\alang1081 \ltrch\lang1058\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1058\kerning1\dbch\af12\langfe2052\loch\ql\ltrpar{\rtlch\afs32\ab \ltrch\loch\fs32\b\loch
now same answer in ukranian}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ql\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1054\'ce\u1089\'f1\u1100\'fc \u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1082\'ea\u1083\'eb\u1072\'e0\u1076\'e4 \u1087\'ef\u1086\'ee\u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1076\'e4\u1085\'ed\u1100\'fc\u1086\'ee\u1111\'bf \u1074\'e2\u1110\'b3\u1076\'e4\u1087\'ef\u1086\'ee\u1074\'e2\u1110\'b3\u1076\'e4\u1110\'b3 (\u1087\'ef\u1088\'f0\u1086\'ee \u1050\'ca\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1077\'e5\u1083\'eb\u1100\'fc \u1058\'d2\u1077\'e5\u1089\'f1\u1077\'e5\u1103\'ff) \u1091\'f3\u1082\'ea\u1088\'f0\u1072\'e0\u1111\'bf\u1085\'ed\u1089\'f1\u1100\'fc\u1082\'ea\u1086\'ee\u1102\'fe:}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1062\'d6\u1077\'e5 \u1082\'ea\u1083\'eb\u1072\'e0\u1089\'f1\u1080\'e8\u1095\'f7\u1085\'ed\u1080\'e8\u1081\'e9 \u1087\'ef\u1072\'e0\u1088\'f0\u1072\'e0\u1076\'e4\u1086\'ee\u1082\'ea\u1089\'f1 }{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1050\'ca\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1103\'ff \u1058\'d2\u1077\'e5\u1089\'f1\u1077\'e5\u1103\'ff}{\rtlch\ab0 \ltrch\loch\b0\loch
, \u1074\'e2\u1087\'ef\u1077\'e5\u1088\'f0\u1096\'f8\u1077\'e5 \u1089\'f1\u1092\'f4\u1086\'ee\u1088\'f0\u1084\'ec\u1091\'f3\u1083\'eb\u1100\'fc\u1086\'ee\u1074\'e2\u1072\'e0\u1085\'ed\u1080\'e8\u1081\'e9 \u1055\'cf\u1083\'eb\u1091\'f3\u1090\'f2\u1072\'e0\u1088\'f0\u1093\'f5\u1086\'ee\u1084\'ec. \u1062\'d6\u1077\'e5 \u1086\'ee\u1076\'e4\u1085\'ed\u1072\'e0 \u1079\'e7 \u1085\'ed\u1072\'e0\u1081\'e9\u1089\'f1\u1090\'f2\u1072\'e0\u1088\'f0\u1110\'b3\u1096\'f8\u1080\'e8\u1093\'f5 \u1092\'f4\u1110\'b3\u1083\'eb\u1086\'ee\u1089\'f1\u1086\'ee\u1092\'f4\u1089\'f1\u1100\'fc\u1082\'ea\u1080\'e8\u1093\'f5 \u1079\'e7\u1072\'e0\u1075\'e3\u1072\'e0\u1076\'e4\u1086\'ee\u1082\'ea \u1087\'ef\u1088\'f0\u1086\'ee \u1090\'f2\u1086\'ee\u1090\'f2\u1086\'ee\u1078\'e6\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc \u1110\'b3 \u1079\'e7\u1073\'e1\u1077\'e5\u1088\'f0\u1077\'e5\u1078\'e6\u1077\'e5\u1085\'ed\u1085\'ed\u1103\'ff \u1086\'ee\u1073\'e1'\u1108\'ba\u1082\'ea\u1090\'f2\u1072\'e0 \u1074\'e2 \u1095\'f7\u1072\'e0\u1089\'f1\u1110\'b3 \u8212\'97 \u1108\'ba\u1076\'e4\u1080\'e8\u1085\'ed\u1086\'ee\u1111\'bf \u1091\'f3\u1089\'f1\u1090\'f2\u1072\'e0\u1083\'eb\u1077\'e5\u1085\'ed\u1086\'ee\u1111\'bf \u1074\'e2\u1110\'b3\u1076\'e4\u1087\'ef\u1086\'ee\u1074\'e2\u1110\'b3\u1076\'e4\u1110\'b3 \u1085\'ed\u1077\'e5\u1084\'ec\u1072\'e0\u1108\'ba, \u1072\'e0\u1083\'eb\u1077\'e5 \u1110\'b3\u1089\'f1\u1085\'ed\u1091\'f3\u1108\'ba \u1082\'ea\u1110\'b3\u1083\'eb\u1100\'fc\u1082\'ea\u1072\'e0 \u1089\'f1\u1077\'e5\u1088\'f0\u1081\'e9\u1086\'ee\u1079\'e7\u1085\'ed\u1080\'e8\u1093\'f5 \u1087\'ef\u1110\'b3\u1076\'e4\u1093\'f5\u1086\'ee\u1076\'e4\u1110\'b3\u1074\'e2 \u1076\'e4\u1086\'ee \u1094\'f6\u1100\'fc\u1086\'ee\u1075\'e3\u1086\'ee \u1087\'ef\u1080\'e8\u1090\'f2\u1072\'e0\u1085\'ed\u1085\'ed\u1103\'ff.}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1057\'d1\u1091\'f3\u1090\'f2\u1100\'fc \u1087\'ef\u1072\'e0\u1088\'f0\u1072\'e0\u1076\'e4\u1086\'ee\u1082\'ea\u1089\'f1\u1091\'f3}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1059\'d3 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1103\'ff \u1087\'ef\u1086\'ee\u1089\'f1\u1090\'f2\u1091\'f3\u1087\'ef\u1086\'ee\u1074\'e2\u1086\'ee, \u1076\'e4\u1086\'ee\u1096\'f8\u1082\'ea\u1072\'e0 \u1079\'e7\u1072\'e0 \u1076\'e4\u1086\'ee\u1096\'f8\u1082\'ea\u1086\'ee\u1102\'fe, \u1079\'e7\u1072\'e0\u1084\'ec\u1110\'b3\u1085\'ed\u1102\'fe\u1102\'fe\u1090\'f2\u1100\'fc \u1091\'f3\u1089\'f1\u1110\'b3 \u1077\'e5\u1083\'eb\u1077\'e5\u1084\'ec\u1077\'e5\u1085\'ed\u1090\'f2\u1080\'e8 \u1087\'ef\u1088\'f0\u1086\'ee\u1090\'f2\u1103\'ff\u1075\'e3\u1086\'ee\u1084\'ec \u1073\'e1\u1072\'e0\u1075\'e3\u1072\'e0\u1090\'f2\u1086\'ee\u1088\'f0\u1110\'b3\u1095\'f7\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1088\'f0\u1077\'e5\u1084\'ec\u1086\'ee\u1085\'ed\u1090\'f2\u1091\'f3, \u1087\'ef\u1086\'ee\u1082\'ea\u1080\'e8 \u1074\'e2\u1088\'f0\u1077\'e5\u1096\'f8\u1090\'f2\u1110\'b3 \u1085\'ed\u1077\'e5 \u1079\'e7\u1072\'e0\u1083\'eb\u1080\'e8\u1096\'f8\u1072\'e0\u1108\'ba\u1090\'f2\u1100\'fc\u1089\'f1\u1103\'ff \u1078\'e6\u1086\'ee\u1076\'e4\u1085\'ed\u1086\'ee\u1111\'bf \u1086\'ee\u1088\'f0\u1080\'e8\u1075\'e3\u1110\'b3\u1085\'ed\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1086\'ee\u1111\'bf \u1076\'e4\u1086\'ee\u1096\'f8\u1082\'ea\u1080\'e8. \u1063\'d7\u1080\'e8 \u1094\'f6\u1077\'e5 \u1074\'e2\u1089\'f1\u1077\'e5 \u1097\'f9\u1077\'e5 \u171\'ab\u1090\'f2\u1086\'ee\u1081\'e9 \u1089\'f1\u1072\'e0\u1084\'ec\u1080\'e8\u1081\'e9\u187\'bb \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1077\'e5\u1083\'eb\u1100\'fc? \u1044\'c4\u1086\'ee\u1076\'e4\u1072\'e0\u1084\'ec\u1086\'ee \u1091\'f3\u1089\'f1\u1082\'ea\u1083\'eb\u1072\'e0\u1076\'e4\u1085\'ed\u1077\'e5\u1085\'ed\u1085\'ed\u1103\'ff: \u1087\'ef\u1088\'f0\u1080\'e8\u1087\'ef\u1091\'f3\u1089\'f1\u1090\'f2\u1080\'e8\u1084\'ec\u1086\'ee, \u1093\'f5\u1090\'f2\u1086\'ee\u1089\'f1\u1100\'fc \u1079\'e7\u1073\'e1\u1080\'e8\u1088\'f0\u1072\'e0\u1074\'e2 \u1091\'f3\u1089\'f1\u1110\'b3 \u1074\'e2\u1080\'e8\u1082\'ea\u1080\'e8\u1085\'ed\u1091\'f3\u1090\'f2\u1110\'b3 \u1086\'ee\u1088\'f0\u1080\'e8\u1075\'e3\u1110\'b3\u1085\'ed\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1110\'b3 \u1076\'e4\u1086\'ee\u1096\'f8\u1082\'ea\u1080\'e8 \u1110\'b3 \u1087\'ef\u1086\'ee\u1073\'e1\u1091\'f3\u1076\'e4\u1091\'f3\u1074\'e2\u1072\'e0\u1074\'e2 \u1079\'e7 \u1085\'ed\u1080\'e8\u1093\'f5 \u1110\'b3\u1085\'ed\u1096\'f8\u1080\'e8\u1081\'e9 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1077\'e5\u1083\'eb\u1100\'fc. \u1071\'df\u1082\'ea\u1080\'e8\u1081\'e9 \u1110\'b3\u1079\'e7 \u1085\'ed\u1080\'e8\u1093\'f5 \u8212\'97 \u1073\'e1\u1077\'e5\u1079\'e7\u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1088\'f0\u1074\'e2\u1085\'ed\u1086\'ee \u1088\'f0\u1077\'e5\u1084\'ec\u1086\'ee\u1085\'ed\u1090\'f2\u1086\'ee\u1074\'e2\u1072\'e0\u1085\'ed\u1080\'e8\u1081\'e9 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1077\'e5\u1083\'eb\u1100\'fc \u1095\'f7\u1080\'e8 \u1079\'e7\u1072\'e0\u1085\'ed\u1086\'ee\u1074\'e2\u1086\'ee \u1079\'e7\u1110\'b3\u1073\'e1\u1088\'f0\u1072\'e0\u1085\'ed\u1080\'e8\u1081\'e9 \u1086\'ee\u1088\'f0\u1080\'e8\u1075\'e3\u1110\'b3\u1085\'ed\u1072\'e0\u1083\'eb \u8212\'97 \u1108\'ba \u171\'ab\u1089\'f1\u1087\'ef\u1088\'f0\u1072\'e0\u1074\'e2\u1078\'e6\u1085\'ed\u1110\'b3\u1084\'ec\u187\'bb \u1050\'ca\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1077\'e5\u1084\'ec \u1058\'d2\u1077\'e5\u1089\'f1\u1077\'e5\u1103\'ff? \u1057\'d1\u1082\'ea\u1072\'e0\u1079\'e7\u1072\'e0\u1090\'f2\u1080\'e8, \u1097\'f9\u1086\'ee \u1086\'ee\u1073\'e1\u1080\'e8\u1076\'e4\u1074\'e2\u1072\'e0, \u1085\'ed\u1077\'e5 \u1090\'f2\u1072\'e0\u1082\'ea \u1087\'ef\u1088\'f0\u1086\'ee\u1089\'f1\u1090\'f2\u1086\'ee.}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1056\'d0\u1110\'b3\u1079\'e7\u1085\'ed\u1110\'b3 \u1092\'f4\u1110\'b3\u1083\'eb\u1086\'ee\u1089\'f1\u1086\'ee\u1092\'f4\u1089\'f1\u1100\'fc\u1082\'ea\u1110\'b3 \u1074\'e2\u1110\'b3\u1076\'e4\u1087\'ef\u1086\'ee\u1074\'e2\u1110\'b3\u1076\'e4\u1110\'b3}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls15 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1055\'cf\u1077\'e5\u1088\'f0\u1076\'e4\u1091\'f3\u1088\'f0\u1072\'e0\u1085\'ed\u1090\'f2\u1080\'e8\u1079\'e7\u1084\'ec}{\rtlch\ab0 \ltrch\loch\b0\loch
 \u8212\'97 \u1086\'ee\u1073\'e1'\u1108\'ba\u1082\'ea\u1090\'f2\u1080\'e8 \u1108\'ba \u1089\'f1\u1074\'e2\u1086\'ee\u1075\'e3\u1086\'ee \u1088\'f0\u1086\'ee\u1076\'e4\u1091\'f3 \u1095\'f7\u1086\'ee\u1090\'f2\u1080\'e8\u1088\'f0\u1080\'e8\u1074\'e2\u1080\'e8\u1084\'ec\u1110\'b3\u1088\'f0\u1085\'ed\u1080\'e8\u1084\'ec\u1080\'e8 \u171\'ab\u1093\'f5\u1088\'f0\u1086\'ee\u1073\'e1\u1072\'e0\u1082\'ea\u1072\'e0\u1084\'ec\u1080\'e8\u187\'bb, \u1088\'f0\u1086\'ee\u1079\'e7\u1090\'f2\u1103\'ff\u1075\'e3\u1085\'ed\u1091\'f3\u1090\'f2\u1080\'e8\u1084\'ec\u1080\'e8 \u1074\'e2 \u1095\'f7\u1072\'e0\u1089\'f1\u1110\'b3; \u1082\'ea \u1088\'f0\u1110\'b3\u1079\'e7\u1085\'ed\u1110\'b3 \u1085\'ed\u1080\'e8\u1090\'f2\u1082\'ea\u1080\'e8 (\u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1110\'b3\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1091\'f3 \u1073\'e1\u1077\'e5\u1079\'e7\u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1088\'f0\u1074\'e2\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc \u1087\'ef\u1088\'f0\u1086\'ee\u1090\'f2\u1080\'e8 \u1089\'f1\u1090\'f2\u1088\'f0\u1091\'f3\u1082\'ea\u1090\'f2\u1091\'f3\u1088\'f0\u1085\'ed\u1086\'ee\u1111\'bf/\u1092\'f4\u1091\'f3\u1085\'ed\u1082\'ea\u1094\'f6\u1110\'b3\u1086\'ee\u1085\'ed\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1086\'ee\u1111\'bf).}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls15 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1028\'aa\u1076\'e4\u1080\'e8\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1082\'ea\u1086\'ee\u1085\'ed\u1089\'f1\u1077\'e5\u1085\'ed\u1089\'f1\u1091\'f3\u1089\'f1\u1091\'f3 \u1085\'ed\u1077\'e5\u1084\'ec\u1072\'e0\u1108\'ba \u8212\'97 \u1110\'b3 \u1089\'f1\u1072\'e0\u1084\'ec\u1077\'e5 \u1094\'f6\u1077\'e5 \u1088\'f0\u1086\'ee\u1073\'e1\u1080\'e8\u1090\'f2\u1100\'fc \u1087\'ef\u1072\'e0\u1088\'f0\u1072\'e0\u1076\'e4\u1086\'ee\u1082\'ea\u1089\'f1 \u1093\'f5\u1086\'ee\u1088\'f0\u1086\'ee\u1096\'f8\u1086\'ee\u1102\'fe \u1092\'f4\u1110\'b3\u1083\'eb\u1086\'ee\u1089\'f1\u1086\'ee\u1092\'f4\u1089\'f1\u1100\'fc\u1082\'ea\u1086\'ee\u1102\'fe \u1087\'ef\u1088\'f0\u1086\'ee\u1073\'e1\u1083\'eb\u1077\'e5\u1084\'ec\u1086\'ee\u1102\'fe, \u1072\'e0 \u1085\'ed\u1077\'e5 \u1074\'e2\u1080\'e8\u1088\'f0\u1110\'b3\u1096\'f8\u1077\'e5\u1085\'ed\u1080\'e8\u1084\'ec \u1079\'e7\u1072\'e0\u1074\'e2\u1076\'e4\u1072\'e0\u1085\'ed\u1085\'ed\u1103\'ff\u1084\'ec. \u1061\'d5\u1086\'ee\u1095\'f7\u1077\'e5\u1090\'f2\u1077\'e5, \u1088\'f0\u1086\'ee\u1079\'e7\u1087\'ef\u1086\'ee\u1074\'e2\u1110\'b3\u1084\'ec, \u1103\'ff\u1082\'ea \u1094\'f6\u1077\'e5 \u1087\'ef\u1086\'ee\u1074\'e2'\u1103\'ff\u1079\'e7\u1072\'e0\u1085\'ed\u1086\'ee \u1079\'e7 \u1090\'f2\u1077\'e5\u1086\'ee\u1088\'f0\u1110\'b3\u1103\'ff\u1084\'ec\u1080\'e8 \u1086\'ee\u1089\'f1\u1086\'ee\u1073\'e1\u1080\'e8\u1089\'f1\u1090\'f2\u1086\'ee\u1111\'bf \u1090\'f2\u1086\'ee\u1090\'f2\u1086\'ee\u1078\'e6\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1110\'b3 (\u1085\'ed\u1072\'e0\u1087\'ef\u1088\'f0\u1080\'e8\u1082\'ea\u1083\'eb\u1072\'e0\u1076\'e4, \u1088\'f0\u1086\'ee\u1073\'e1\u1086\'ee\u1090\'f2\u1072\'e0\u1084\'ec\u1080\'e8 \u1044\'c4\u1077\'e5\u1088\'f0\u1077\'e5\u1082\'ea\u1072\'e0 \u1055\'cf\u1072\'e0\u1088\'f0\u1092\'f4\u1110\'b3\u1090\'f2\u1072\'e0), \u1072\'e0\u1073\'e1\u1086\'ee \u1079\'e7\u1072\'e0\u1089\'f1\u1090\'f2\u1086\'ee\u1089\'f1\u1091\'f3\u1102\'fe \u1094\'f6\u1077\'e5 \u1076\'e4\u1086\'ee \u1089\'f1\u1091\'f3\u1095\'f7\u1072\'e0\u1089\'f1\u1085\'ed\u1110\'b3\u1096\'f8\u1086\'ee\u1075\'e3\u1086\'ee \u1074\'e2\u1080\'e8\u1087\'ef\u1072\'e0\u1076\'e4\u1082\'ea\u1091\'f3?\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1077\'e5\u1083\'eb\u1100\'fc \u1091\'f3 \u1073\'e1\u1091\'f3\u1076\'e4\u1100\'fc-\u1103\'ff\u1082\'ea\u1080\'e8\u1081\'e9 \u1084\'ec\u1086\'ee\u1084\'ec\u1077\'e5\u1085\'ed\u1090\'f2 \u8212\'97 \u1094\'f6\u1077\'e5 \u1083\'eb\u1080\'e8\u1096\'f8\u1077\'e5 \u1095\'f7\u1072\'e0\u1089\'f1\u1086\'ee\u1074\'e2\u1080\'e8\u1081\'e9 \u1079\'e7\u1088\'f0\u1110\'b3\u1079\'e7 \u1076\'e4\u1086\'ee\u1074\'e2\u1096\'f8\u1086\'ee\u1111\'bf \u1089\'f1\u1091\'f3\u1090\'f2\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1110\'b3. \u1047\'c7 \u1094\'f6\u1110\'b3\u1108\'ba\u1111\'bf \u1090\'f2\u1086\'ee\u1095\'f7\u1082\'ea\u1080\'e8 \u1079\'e7\u1086\'ee\u1088\'f0\u1091\'f3 \u1087\'ef\u1086\'ee\u1089\'f1\u1090\'f2\u1091\'f3\u1087\'ef\u1086\'ee\u1074\'e2\u1072\'e0 \u1079\'e7\u1072\'e0\u1084\'ec\u1110\'b3\u1085\'ed\u1072\'e0 \u1085\'ed\u1077\'e5 \u1087\'ef\u1086\'ee\u1088\'f0\u1091\'f3\u1096\'f8\u1091\'f3\u1108\'ba \u1090\'f2\u1086\'ee\u1090\'f2\u1086\'ee\u1078\'e6\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc, \u1090\'f2\u1086\'ee\u1084\'ec\u1091\'f3 \u1097\'f9\u1086\'ee \u1090\'f2\u1086\'ee\u1090\'f2\u1086\'ee\u1078\'e6\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc \u1087\'ef\u1086\'ee\u1074\'e2'\u1103\'ff\u1079\'e7\u1072\'e0\u1085\'ed\u1072\'e0 \u1085\'ed\u1077\'e5 \u1079\'e7 \u1082\'ea\u1086\'ee\u1085\'ed\u1082\'ea\u1088\'f0\u1077\'e5\u1090\'f2\u1085\'ed\u1080\'e8\u1084\'ec \u1085\'ed\u1072\'e0\u1073\'e1\u1086\'ee\u1088\'f0\u1086\'ee\u1084\'ec \u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1110\'b3\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1080\'e8\u1093\'f5 \u1095\'f7\u1072\'e0\u1089\'f1\u1090\'f2\u1080\'e8\u1085\'ed, \u1072\'e0 \u1079\'e7 \u1073\'e1\u1077\'e5\u1079\'e7\u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1088\'f0\u1074\'e2\u1085\'ed\u1080\'e8\u1084\'ec \u1087\'ef\u1088\'f0\u1080\'e8\u1095\'f7\u1080\'e8\u1085\'ed\u1085\'ed\u1080\'e8\u1084\'ec \u1083\'eb\u1072\'e0\u1085\'ed\u1094\'f6\u1102\'fe\u1075\'e3\u1086\'ee\u1084\'ec \u1091\'f3 \u1087\'ef\u1088\'f0\u1086\'ee\u1089\'f1\u1090\'f2\u1086\'ee\u1088\'f0\u1110\'b3-\u1095\'f7\u1072\'e0\u1089\'f1\u1110\'b3. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls15 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1052\'cc\u1077\'e5\u1088\'f0\u1077\'e5\u1086\'ee\u1083\'eb\u1086\'ee\u1075\'e3\u1110\'b3\u1095\'f7\u1085\'ed\u1080\'e8\u1081\'e9 \u1077\'e5\u1089\'f1\u1077\'e5\u1085\'ed\u1094\'f6\u1110\'b3\u1072\'e0\u1083\'eb\u1110\'b3\u1079\'e7\u1084\'ec}{\rtlch\ab0 \ltrch\loch\b0\loch
 \u8212\'97 \u1090\'f2\u1086\'ee\u1090\'f2\u1086\'ee\u1078\'e6\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc \u1086\'ee\u1073\'e1'\u1108\'ba\u1082\'ea\u1090\'f2\u1072\'e0 \u1079\'e7\u1072\'e0\u1083\'eb\u1077\'e5\u1078\'e6\u1080\'e8\u1090\'f2\u1100\'fc \u1074\'e2\u1110\'b3\u1076\'e4 \u1090\'f2\u1086\'ee\u1075\'e3\u1086\'ee, \u1095\'f7\u1080\'e8 \u1084\'ec\u1072\'e0\u1108\'ba \u1074\'e2\u1110\'b3\u1085\'ed \u1090\'f2\u1110\'b3 \u1089\'f1\u1072\'e0\u1084\'ec\u1110\'b3 \u1095\'f7\u1072\'e0\u1089\'f1\u1090\'f2\u1080\'e8\u1085\'ed\u1080\'e8. \u1047\'c7 \u1094\'f6\u1110\'b3\u1108\'ba\u1111\'bf \u1089\'f1\u1091\'f3\u1074\'e2\u1086\'ee\u1088\'f0\u1086\'ee\u1111\'bf \u1087\'ef\u1086\'ee\u1079\'e7\u1080\'e8\u1094\'f6\u1110\'b3\u1111\'bf, \u1079\'e7\u1072\'e0\u1084\'ec\u1110\'b3\u1085\'ed\u1080\'e8\u1074\'e2\u1096\'f8\u1080\'e8 \u1093\'f5\u1086\'ee\u1095\'f7\u1072\'e0 \u1073\'e1 \u1086\'ee\u1076\'e4\u1085\'ed\u1091\'f3 \u1076\'e4\u1086\'ee\u1096\'f8\u1082\'ea\u1091\'f3, \u1074\'e2\u1080\'e8 \u1090\'f2\u1077\'e5\u1093\'f5\u1085\'ed\u1110\'b3\u1095\'f7\u1085\'ed\u1086\'ee \u1086\'ee\u1090\'f2\u1088\'f0\u1080\'e8\u1084\'ec\u1091\'f3\u1108\'ba\u1090\'f2\u1077\'e5 }{\rtlch\ab0 \ltrch\loch\cs43\rtlch\ai \ltrch\loch\i\b0\loch
\u1110\'b3\u1085\'ed\u1096\'f8\u1080\'e8\u1081\'e9}{\rtlch\ab0 \ltrch\loch\b0\loch
 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1077\'e5\u1083\'eb\u1100\'fc (\u1072\'e0\u1073\'e1\u1086\'ee \u1087\'ef\u1088\'f0\u1080\'e8\u1085\'ed\u1072\'e0\u1081\'e9\u1084\'ec\u1085\'ed\u1110\'b3 \u1110\'b3\u1085\'ed\u1096\'f8\u1080\'e8\u1081\'e9 \u1086\'ee\u1073\'e1'\u1108\'ba\u1082\'ea\u1090\'f2), \u1085\'ed\u1072\'e0\u1074\'e2\u1110\'b3\u1090\'f2\u1100\'fc \u1103\'ff\u1082\'ea\u1097\'f9\u1086\'ee \u1079\'e7\u1072\'e0 \u1079\'e7\u1074\'e2\u1080\'e8\u1095\'f7\u1082\'ea\u1086\'ee\u1102\'fe \u1087\'ef\u1088\'f0\u1086\'ee\u1076\'e4\u1086\'ee\u1074\'e2\u1078\'e6\u1091\'f3\u1108\'ba\u1084\'ec\u1086\'ee \u1085\'ed\u1072\'e0\u1079\'e7\u1080\'e8\u1074\'e2\u1072\'e0\u1090\'f2\u1080\'e8 \u1081\'e9\u1086\'ee\u1075\'e3\u1086\'ee \u171\'ab\u1090\'f2\u1080\'e8\u1084\'ec \u1089\'f1\u1072\'e0\u1084\'ec\u1080\'e8\u1084\'ec\u187\'bb. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls15 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1058\'d2\u1077\'e5\u1086\'ee\u1088\'f0\u1110\'b3\u1103\'ff \u1079\'e7\u1074\'e2'\u1103\'ff\u1079\'e7\u1086\'ee\u1082\'ea / \u1088\'f0\u1077\'e5\u1083\'eb\u1103\'ff\u1094\'f6\u1110\'b3\u1081\'e9\u1085\'ed\u1072\'e0 \u1090\'f2\u1086\'ee\u1090\'f2\u1086\'ee\u1078\'e6\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc}{\rtlch\ab0 \ltrch\loch\b0\loch
 \u8212\'97 \u1090\'f2\u1077\'e5, \u1097\'f9\u1086\'ee \u1088\'f0\u1086\'ee\u1073\'e1\u1080\'e8\u1090\'f2\u1100\'fc \u1097\'f9\u1086\'ee\u1089\'f1\u1100\'fc \u171\'ab\u1090\'f2\u1080\'e8\u1084\'ec \u1089\'f1\u1072\'e0\u1084\'ec\u1080\'e8\u1084\'ec \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1077\'e5\u1084\'ec\u187\'bb, \u1094\'f6\u1077\'e5 \u1085\'ed\u1077\'e5 \u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1110\'b3\u1072\'e0\u1083\'eb, \u1072\'e0 \u1079\'e7\u1073\'e1\u1077\'e5\u1088\'f0\u1077\'e5\u1078\'e6\u1077\'e5\u1085\'ed\u1085\'ed\u1103\'ff \u1089\'f1\u1090\'f2\u1088\'f0\u1091\'f3\u1082\'ea\u1090\'f2\u1091\'f3\u1088\'f0\u1080\'e8, \u1092\'f4\u1091\'f3\u1085\'ed\u1082\'ea\u1094\'f6\u1110\'b3\u1111\'bf \u1090\'f2\u1072\'e0 \u1092\'f4\u1086\'ee\u1088\'f0\u1084\'ec\u1080\'e8 \u8212\'97 \u1090\'f2\u1072\'e0 \u1089\'f1\u1072\'e0\u1084\'ec\u1072\'e0 \u1092\'f4\u1086\'ee\u1088\'f0\u1084\'ec\u1072\'e0, \u1090\'f2\u1072\'e0 \u1089\'f1\u1072\'e0\u1084\'ec\u1072\'e0 \u1084\'ec\u1077\'e5\u1090\'f2\u1072\'e0, \u1090\'f2\u1072\'e0 \u1089\'f1\u1072\'e0\u1084\'ec\u1072\'e0 \u1073\'e1\u1077\'e5\u1079\'e7\u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1088\'f0\u1074\'e2\u1085\'ed\u1072\'e0 \u1110\'b3\u1089\'f1\u1090\'f2\u1086\'ee\u1088\'f0\u1110\'b3\u1103\'ff \u1074\'e2\u1080\'e8\u1082\'ea\u1086\'ee\u1088\'f0\u1080\'e8\u1089\'f1\u1090\'f2\u1072\'e0\u1085\'ed\u1085\'ed\u1103\'ff. \u1047\'c7 \u1094\'f6\u1110\'b3\u1108\'ba\u1111\'bf \u1090\'f2\u1086\'ee\u1095\'f7\u1082\'ea\u1080\'e8 \u1079\'e7\u1086\'ee\u1088\'f0\u1091\'f3 \u1074\'e2\u1110\'b3\u1076\'e4\u1088\'f0\u1077\'e5\u1084\'ec\u1086\'ee\u1085\'ed\u1090\'f2\u1086\'ee\u1074\'e2\u1072\'e0\u1085\'ed\u1080\'e8\u1081\'e9 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1077\'e5\u1083\'eb\u1100\'fc \u1074\'e2\u1074\'e2\u1072\'e0\u1078\'e6\u1072\'e0\u1108\'ba\u1090\'f2\u1100\'fc\u1089\'f1\u1103\'ff \u1090\'f2\u1080\'e8\u1084\'ec \u1089\'f1\u1072\'e0\u1084\'ec\u1080\'e8\u1084\'ec \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1077\'e5\u1084\'ec, \u1073\'e1\u1086\'ee \u1087\'ef\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1085\'ed \u1079\'e7\u1073\'e1\u1077\'e5\u1088\'f0\u1110\'b3\u1075\'e3\u1089\'f1\u1103\'ff, \u1085\'ed\u1072\'e0\u1074\'e2\u1110\'b3\u1090\'f2\u1100\'fc \u1082\'ea\u1086\'ee\u1083\'eb\u1080\'e8 \u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1110\'b3\u1072\'e0\u1083\'eb \u1087\'ef\u1086\'ee\u1074\'e2\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1102\'fe \u1079\'e7\u1084\'ec\u1110\'b3\u1085\'ed\u1080\'e8\u1074\'e2\u1089\'f1\u1103\'ff \u8212\'97 \u1087\'ef\u1086\'ee\u1076\'e4\u1110\'b3\u1073\'e1\u1085\'ed\u1086\'ee \u1076\'e4\u1086\'ee \u1090\'f2\u1086\'ee\u1075\'e3\u1086\'ee, \u1103\'ff\u1082\'ea \u1088\'f0\u1110\'b3\u1095\'f7\u1082\'ea\u1072\'e0 \u1079\'e7\u1072\'e0\u1083\'eb\u1080\'e8\u1096\'f8\u1072\'e0\u1108\'ba\u1090\'f2\u1100\'fc\u1089\'f1\u1103\'ff \u171\'ab\u1090\'f2\u1110\'b3\u1108\'ba\u1102\'fe \u1089\'f1\u1072\'e0\u1084\'ec\u1086\'ee\u1102\'fe \u1088\'f0\u1110\'b3\u1082\'ea\u1086\'ee\u1102\'fe\u187\'bb, \u1093\'f5\u1086\'ee\u1095\'f7\u1072\'e0 \u1074\'e2\u1086\'ee\u1076\'e4\u1072\'e0 \u1074\'e2 \u1085\'ed\u1110\'b3\u1081\'e9 \u1087\'ef\u1086\'ee\u1089\'f1\u1090\'f2\u1110\'b3\u1081\'e9\u1085\'ed\u1086\'ee \u1090\'f2\u1077\'e5\u1095\'f7\u1077\'e5 \u1110\'b3 \u1079\'e7\u1084\'ec\u1110\'b3\u1085\'ed\u1102\'fe\u1108\'ba\u1090\'f2\u1100\'fc\u1089\'f1\u1103\'ff. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls15 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1050\'ca\u1086\'ee\u1085\'ed\u1074\'e2\u1077\'e5\u1085\'ed\u1094\'f6\u1110\'b3\u1086\'ee\u1085\'ed\u1072\'e0\u1083\'eb\u1110\'b3\u1079\'e7\u1084\'ec}{\rtlch\ab0 \ltrch\loch\b0\loch
 \u8212\'97 \u1078\'e6\u1086\'ee\u1076\'e4\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1086\'ee\u1073\'e1'\u1108\'ba\u1082\'ea\u1090\'f2\u1080\'e8\u1074\'e2\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1092\'f4\u1072\'e0\u1082\'ea\u1090\'f2\u1091\'f3 \u1090\'f2\u1091\'f3\u1090\'f2 \u1091\'f3\u1079\'e7\u1072\'e0\u1075\'e3\u1072\'e0\u1083\'eb\u1110\'b3 \u1085\'ed\u1077\'e5\u1084\'ec\u1072\'e0\u1108\'ba. \u171\'ab\u1058\'d2\u1086\'ee\u1081\'e9 \u1089\'f1\u1072\'e0\u1084\'ec\u1080\'e8\u1081\'e9 \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1077\'e5\u1083\'eb\u1100\'fc\u187\'bb \u8212\'97 \u1085\'ed\u1077\'e5 \u1075\'e3\u1083\'eb\u1080\'e8\u1073\'e1\u1086\'ee\u1082\'ea\u1072\'e0 \u1084\'ec\u1077\'e5\u1090\'f2\u1072\'e0\u1092\'f4\u1110\'b3\u1079\'e7\u1080\'e8\u1095\'f7\u1085\'ed\u1072\'e0 \u1110\'b3\u1089\'f1\u1090\'f2\u1080\'e8\u1085\'ed\u1072\'e0, \u1103\'ff\u1082\'ea\u1091\'f3 \u1090\'f2\u1088\'f0\u1077\'e5\u1073\'e1\u1072\'e0 \u1074\'e2\u1110\'b3\u1076\'e4\u1082\'ea\u1088\'f0\u1080\'e8\u1090\'f2\u1080\'e8, \u1072\'e0 \u1084\'ec\u1086\'ee\u1074\'e2\u1085\'ed\u1072\'e0/\u1089\'f1\u1086\'ee\u1094\'f6\u1110\'b3\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1072\'e0 \u1076\'e4\u1086\'ee\u1084\'ec\u1086\'ee\u1074\'e2\u1083\'eb\u1077\'e5\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc. \u1052\'cc\u1080\'e8 \u1074\'e2\u1080\'e8\u1088\'f0\u1110\'b3\u1096\'f8\u1091\'f3\u1108\'ba\u1084\'ec\u1086\'ee, \u1097\'f9\u1086\'ee \u1074\'e2\u1074\'e2\u1072\'e0\u1078\'e6\u1072\'e0\u1090\'f2\u1080\'e8 \u171\'ab\u1090\'f2\u1080\'e8\u1084\'ec \u1089\'f1\u1072\'e0\u1084\'ec\u1080\'e8\u1084\'ec\u187\'bb, \u1074\'e2\u1080\'e8\u1093\'f5\u1086\'ee\u1076\'e4\u1103\'ff\u1095\'f7\u1080\'e8 \u1079\'e7 \u1087\'ef\u1088\'f0\u1072\'e0\u1082\'ea\u1090\'f2\u1080\'e8\u1095\'f7\u1085\'ed\u1080\'e8\u1093\'f5 \u1094\'f6\u1110\'b3\u1083\'eb\u1077\'e5\u1081\'e9 (\u1087\'ef\u1088\'f0\u1072\'e0\u1074\'e2\u1086\'ee \u1074\'e2\u1083\'eb\u1072\'e0\u1089\'f1\u1085\'ed\u1086\'ee\u1089\'f1\u1090\'f2\u1110\'b3, \u1110\'b3\u1089\'f1\u1090\'f2\u1086\'ee\u1088\'f0\u1080\'e8\u1095\'f7\u1085\'ed\u1072\'e0 \u1089\'f1\u1087\'ef\u1072\'e0\u1076\'e4\u1082\'ea\u1086\'ee\u1108\'ba\u1084\'ec\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc \u1090\'f2\u1086\'ee\u1097\'f9\u1086\'ee), \u1110\'b3 \u1088\'f0\u1110\'b3\u1079\'e7\u1085\'ed\u1110\'b3 \u1094\'f6\u1110\'b3\u1083\'eb\u1110\'b3 \u1094\'f6\u1110\'b3\u1083\'eb\u1082\'ea\u1086\'ee\u1084\'ec \u1084\'ec\u1086\'ee\u1078\'e6\u1091\'f3\u1090\'f2\u1100\'fc \u1076\'e4\u1072\'e0\u1074\'e2\u1072\'e0\u1090\'f2\u1080\'e8 \u1088\'f0\u1110\'b3\u1079\'e7\u1085\'ed\u1110\'b3 \u1074\'e2\u1110\'b3\u1076\'e4\u1087\'ef\u1086\'ee\u1074\'e2\u1110\'b3\u1076\'e4\u1110\'b3. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1063\'d7\u1086\'ee\u1084\'ec\u1091\'f3 \u1094\'f6\u1077\'e5 \u1074\'e2\u1072\'e0\u1078\'e6\u1083\'eb\u1080\'e8\u1074\'e2\u1086\'ee \u1085\'ed\u1077\'e5 \u1083\'eb\u1080\'e8\u1096\'f8\u1077\'e5 \u1076\'e4\u1083\'eb\u1103\'ff \u1082\'ea\u1086\'ee\u1088\'f0\u1072\'e0\u1073\'e1\u1083\'eb\u1110\'b3\u1074\'e2}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1062\'d6\u1077\'e5 \u1085\'ed\u1077\'e5 \u1087\'ef\u1088\'f0\u1086\'ee\u1089\'f1\u1090\'f2\u1086\'ee \u1091\'f3\u1103\'ff\u1074\'e2\u1085\'ed\u1080\'e8\u1081\'e9 \u1077\'e5\u1082\'ea\u1089\'f1\u1087\'ef\u1077\'e5\u1088\'f0\u1080\'e8\u1084\'ec\u1077\'e5\u1085\'ed\u1090\'f2 \u1079\'e7\u1072\'e0\u1088\'f0\u1072\'e0\u1076\'e4\u1080\'e8 \u1089\'f1\u1072\'e0\u1084\'ec\u1086\'ee\u1075\'e3\u1086\'ee \u1089\'f1\u1077\'e5\u1073\'e1\u1077\'e5 \u8212\'97 \u1094\'f6\u1077\'e5 \u1084\'ec\u1086\'ee\u1076\'e4\u1077\'e5\u1083\'eb\u1100\'fc \u1076\'e4\u1083\'eb\u1103\'ff \u1087\'ef\u1080\'e8\u1090\'f2\u1072\'e0\u1085\'ed\u1100\'fc \u1087\'ef\u1088\'f0\u1086\'ee \u1090\'f2\u1086\'ee\u1090\'f2\u1086\'ee\u1078\'e6\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc, \u1103\'ff\u1082\'ea\u1110\'b3 \u1079\'e7\u1072\'e0\u1089\'f1\u1090\'f2\u1086\'ee\u1089\'f1\u1086\'ee\u1074\'e2\u1085\'ed\u1110\'b3 \u1074\'e2\u1089\'f1\u1102\'fe\u1076\'e4\u1080\'e8:}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls16 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1042\'c2\u1072\'e0\u1096\'f8\u1077\'e5 \u1090\'f2\u1110\'b3\u1083\'eb\u1086\'ee \u1079\'e7\u1072\'e0\u1084\'ec\u1110\'b3\u1085\'ed\u1102\'fe\u1108\'ba \u1084\'ec\u1072\'e0\u1081\'e9\u1078\'e6\u1077\'e5 \u1074\'e2\u1089\'f1\u1110\'b3 \u1089\'f1\u1074\'e2\u1086\'ee\u1111\'bf \u1082\'ea\u1083\'eb\u1110\'b3\u1090\'f2\u1080\'e8\u1085\'ed\u1080\'e8 \u1087\'ef\u1088\'f0\u1080\'e8\u1073\'e1\u1083\'eb\u1080\'e8\u1079\'e7\u1085\'ed\u1086\'ee \u1079\'e7\u1072\'e0 7\u8211\'9610 \u1088\'f0\u1086\'ee\u1082\'ea\u1110\'b3\u1074\'e2 \u8212\'97 \u1095\'f7\u1080\'e8 \u1074\'e2\u1080\'e8 \u171\'ab\u1090\'f2\u1072\'e0 \u1089\'f1\u1072\'e0\u1084\'ec\u1072\'e0 \u1083\'eb\u1102\'fe\u1076\'e4\u1080\'e8\u1085\'ed\u1072\'e0\u187\'bb, \u1103\'ff\u1082\'ea\u1086\'ee\u1102\'fe \u1073\'e1\u1091\'f3\u1083\'eb\u1080\'e8 \u1076\'e4\u1077\'e5\u1089\'f1\u1103\'ff\u1090\'f2\u1100\'fc \u1088\'f0\u1086\'ee\u1082\'ea\u1110\'b3\u1074\'e2 \u1090\'f2\u1086\'ee\u1084\'ec\u1091\'f3? }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls16 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1042\'c2\u1086\'ee\u1076\'e4\u1072\'e0 \u1074\'e2 \u1088\'f0\u1110\'b3\u1095\'f7\u1094\'f6\u1110\'b3 \u1085\'ed\u1110\'b3\u1082\'ea\u1086\'ee\u1083\'eb\u1080\'e8 \u1085\'ed\u1077\'e5 \u1090\'f2\u1072\'e0 \u1089\'f1\u1072\'e0\u1084\'ec\u1072\'e0 \u1076\'e4\u1074\'e2\u1110\'b3\u1095\'f7\u1110\'b3, \u1086\'ee\u1076\'e4\u1085\'ed\u1072\'e0\u1082\'ea \u1084\'ec\u1080\'e8 \u1085\'ed\u1072\'e0\u1079\'e7\u1080\'e8\u1074\'e2\u1072\'e0\u1108\'ba\u1084\'ec\u1086\'ee \u1111\'bf\u1111\'bf \u1090\'f2\u1110\'b3\u1108\'ba\u1102\'fe \u1089\'f1\u1072\'e0\u1084\'ec\u1086\'ee\u1102\'fe \u1088\'f0\u1110\'b3\u1095\'f7\u1082\'ea\u1086\'ee\u1102\'fe. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls16 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1050\'ca\u1086\'ee\u1084\'ec\u1087\'ef\u1072\'e0\u1085\'ed\u1110\'b3\u1103\'ff \u1084\'ec\u1086\'ee\u1078\'e6\u1077\'e5 \u1087\'ef\u1086\'ee\u1074\'e2\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1102\'fe \u1079\'e7\u1084\'ec\u1110\'b3\u1085\'ed\u1080\'e8\u1090\'f2\u1080\'e8 \u1074\'e2\u1089\'f1\u1110\'b3\u1093\'f5 \u1087\'ef\u1088\'f0\u1072\'e0\u1094\'f6\u1110\'b3\u1074\'e2\u1085\'ed\u1080\'e8\u1082\'ea\u1110\'b3\u1074\'e2 \u1110\'b3 \u1074\'e2\u1089\'f1\u1077\'e5 \u1078\'e6 \u1074\'e2\u1074\'e2\u1072\'e0\u1078\'e6\u1072\'e0\u1090\'f2\u1080\'e8\u1089\'f1\u1103\'ff \u171\'ab\u1090\'f2\u1110\'b3\u1108\'ba\u1102\'fe \u1089\'f1\u1072\'e0\u1084\'ec\u1086\'ee\u1102\'fe\u187\'bb \u1086\'ee\u1088\'f0\u1075\'e3\u1072\'e0\u1085\'ed\u1110\'b3\u1079\'e7\u1072\'e0\u1094\'f6\u1110\'b3\u1108\'ba\u1102\'fe. }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch{\listtext\pard\plain \rtlch\af9 \ltrch\hich\af3\loch\f3 \u8226\'95\tab}\ilvl0\ls16 \li1418\ri0\lin1418\rin0\fi-283\sl276\slmult1\tx0\li709\ri0\lin709\rin0\fi-283\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\b0\loch
\u1055\'cf\u1088\'f0\u1086\'ee\u1075\'e3\u1088\'f0\u1072\'e0\u1084\'ec\u1085\'ed\u1077\'e5 \u1079\'e7\u1072\'e0\u1073\'e1\u1077\'e5\u1079\'e7\u1087\'ef\u1077\'e5\u1095\'f7\u1077\'e5\u1085\'ed\u1085\'ed\u1103\'ff \u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1087\'ef\u1080\'e8\u1089\'f1\u1091\'f3\u1108\'ba\u1090\'f2\u1100\'fc\u1089\'f1\u1103\'ff \u1084\'ec\u1086\'ee\u1076\'e4\u1091\'f3\u1083\'eb\u1100\'fc \u1079\'e7\u1072\'e0 \u1084\'ec\u1086\'ee\u1076\'e4\u1091\'f3\u1083\'eb\u1077\'e5\u1084\'ec \u8212\'97 \u1091\'f3 \u1103\'ff\u1082\'ea\u1080\'e8\u1081\'e9 \u1084\'ec\u1086\'ee\u1084\'ec\u1077\'e5\u1085\'ed\u1090\'f2 \u1094\'f6\u1077\'e5 \u1074\'e2\u1078\'e6\u1077\'e5 \u1085\'ed\u1086\'ee\u1074\'e2\u1072\'e0 \u1087\'ef\u1088\'f0\u1086\'ee\u1075\'e3\u1088\'f0\u1072\'e0\u1084\'ec\u1072\'e0? }
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\sb0\sa0\ltrpar{\rtlch\ab0 \ltrch\loch\cs15\rtlch\ab \ltrch\loch\b\b0\loch
\u1050\'ca\u1086\'ee\u1088\'f0\u1080\'e8\u1089\'f1\u1085\'ed\u1080\'e8\u1081\'e9 \u1089\'f1\u1087\'ef\u1086\'ee\u1089\'f1\u1110\'b3\u1073\'e1 \u1086\'ee\u1089\'f1\u1084\'ec\u1080\'e8\u1089\'f1\u1083\'eb\u1080\'e8\u1090\'f2\u1080\'e8 \u1094\'f6\u1077\'e5}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ql\tx0\li0\ri0\lin0\rin0\fi0\ltrpar{\rtlch\afs22\ab0 \ltrch\loch\fs22\b0\loch
\u1055\'cf\u1086\'ee\u1096\'f8\u1080\'e8\u1088\'f0\u1077\'e5\u1085\'ed\u1072\'e0 \u1089\'f1\u1091\'f3\u1095\'f7\u1072\'e0\u1089\'f1\u1085\'ed\u1072\'e0 \u1090\'f2\u1086\'ee\u1095\'f7\u1082\'ea\u1072\'e0 \u1079\'e7\u1086\'ee\u1088\'f0\u1091\'f3: \u1090\'f2\u1086\'ee\u1090\'f2\u1086\'ee\u1078\'e6\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc \u1091\'f3 \u1095\'f7\u1072\'e0\u1089\'f1\u1110\'b3 \u8212\'97 \u1094\'f6\u1077\'e5 \u1085\'ed\u1077\'e5 \u1087\'ef\u1088\'f0\u1086\'ee \u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1110\'b3\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1091\'f3 \u1110\'b3\u1076\'e4\u1077\'e5\u1085\'ed\u1090\'f2\u1080\'e8\u1095\'f7\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc, \u1072\'e0 \u1087\'ef\u1088\'f0\u1086\'ee \u1073\'e1\u1077\'e5\u1079\'e7\u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1088\'f0\u1074\'e2\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc \u8212\'97 \u1085\'ed\u1077\'e5\u1088\'f0\u1086\'ee\u1079\'e7\u1088\'f0\u1080\'e8\u1074\'e2\u1085\'ed\u1080\'e8\u1081\'e9 \u1083\'eb\u1072\'e0\u1085\'ed\u1094\'f6\u1102\'fe\u1075\'e3 \u1087\'ef\u1086\'ee\u1089\'f1\u1090\'f2\u1091\'f3\u1087\'ef\u1086\'ee\u1074\'e2\u1080\'e8\u1093\'f5 \u1079\'e7\u1084\'ec\u1110\'b3\u1085\'ed, \u1076\'e4\u1077\'e5 \u1085\'ed\u1072\'e0 \u1082\'ea\u1086\'ee\u1078\'e6\u1085\'ed\u1086\'ee\u1084\'ec\u1091\'f3 \u1082\'ea\u1088\'f0\u1086\'ee\u1094\'f6\u1110\'b3 \u1076\'e4\u1086\'ee\u1089\'f1\u1090\'f2\u1072\'e0\u1090\'f2\u1085\'ed\u1100\'fc\u1086\'ee \u1079\'e7\u1073\'e1\u1110\'b3\u1075\'e3\u1091\'f3 \u1079\'e7 \u1087\'ef\u1086\'ee\u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1076\'e4\u1085\'ed\u1110\'b3\u1084\'ec \u1089\'f1\u1090\'f2\u1072\'e0\u1085\'ed\u1086\'ee\u1084\'ec, \u1097\'f9\u1086\'ee\u1073\'e1 \u1084\'ec\u1080\'e8 \u1073\'e1\u1091\'f3\u1083\'eb\u1080\'e8 \u1075\'e3\u1086\'ee\u1090\'f2\u1086\'ee\u1074\'e2\u1110\'b3 \u1089\'f1\u1082\'ea\u1072\'e0\u1079\'e7\u1072\'e0\u1090\'f2\u1080\'e8: \u171\'ab\u1090\'f2\u1072\'e0\u1082\'ea, \u1094\'f6\u1077\'e5 \u1074\'e2\u1089\'f1\u1077\'e5 \u1097\'f9\u1077\'e5 \u1074\'e2\u1086\'ee\u1085\'ed\u1086\'ee\u187\'bb. \u1055\'cf\u1072\'e0\u1088\'f0\u1072\'e0\u1076\'e4\u1086\'ee\u1082\'ea\u1089\'f1 \u1074\'e2\u1080\'e8\u1085\'ed\u1080\'e8\u1082\'ea\u1072\'e0\u1108\'ba \u1089\'f1\u1072\'e0\u1084\'ec\u1077\'e5 \u1090\'f2\u1086\'ee\u1076\'e4\u1110\'b3, \u1082\'ea\u1086\'ee\u1083\'eb\u1080\'e8 }{\rtlch\afs22\ab0 \ltrch\loch\cs43\rtlch\ai \ltrch\loch\i\fs22\b0\loch
\u1086\'ee\u1088\'f0\u1080\'e8\u1075\'e3\u1110\'b3\u1085\'ed\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1080\'e8\u1081\'e9 \u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5\u1088\'f0\u1110\'b3\u1072\'e0\u1083\'eb}{\rtlch\afs22\ab0 \ltrch\loch\fs22\b0\loch
 \u1079\'e7\u1073\'e1\u1080\'e8\u1088\'f0\u1072\'e0\u1102\'fe\u1090\'f2\u1100\'fc \u1079\'e7\u1072\'e0\u1085\'ed\u1086\'ee\u1074\'e2\u1086\'ee \u1086\'ee\u1082\'ea\u1088\'f0\u1077\'e5\u1084\'ec\u1086\'ee, \u1073\'e1\u1086\'ee \u1094\'f6\u1077\'e5 \u1089\'f1\u1090\'f2\u1074\'e2\u1086\'ee\u1088\'f0\u1102\'fe\u1108\'ba \u1076\'e4\u1074\'e2\u1072\'e0 \u1086\'ee\u1073\'e1'\u1108\'ba\u1082\'ea\u1090\'f2\u1080\'e8, \u1082\'ea\u1086\'ee\u1078\'e6\u1077\'e5\u1085\'ed \u1079\'e7 \u1103\'ff\u1082\'ea\u1080\'e8\u1093\'f5 \u1084\'ec\u1072\'e0\u1108\'ba \u1079\'e7\u1072\'e0\u1082\'ea\u1086\'ee\u1085\'ed\u1085\'ed\u1077\'e5 \u1087\'ef\u1088\'f0\u1072\'e0\u1074\'e2\u1086\'ee \u1085\'ed\u1072\'e0 \u1073\'e1\u1077\'e5\u1079\'e7\u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1088\'f0\u1074\'e2\u1085\'ed\u1110\'b3\u1089\'f1\u1090\'f2\u1100\'fc}
\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ql\tx0\li0\ri0\lin0\rin0\fi0\ltrpar\rtlch\ab0 \ltrch\loch\b0\loch

\par \pard\plain \s183\loch\sl276\slmult1\sb0\sa140\loch\sl276\slmult1\ql\tx0\li0\ri0\lin0\rin0\fi0\ltrpar\rtlch\ab0 \ltrch\loch\b0\loch

