84 \u1080\'84\'79 \u1087\'84\'81\u1086\'84\'80\u1082\'84\'7b\u1072\'84\'70\u1079\'84\'78\u1099\'84\'8d\u1074\'84\'72\u1072\'84\'70\u1077\'84\'75\u1090\'84\'84 \u1075\'84\'73\u1083\'84\'7c\u1072\'84\'70\u1074\'84\'72\u1085\'84\'7e\u1099\'84\'8d\u1077\'84\'75 \u1085\'84\'7e\u1086\'84\'80\u1074\'84\'72\u1086\'84\'80\u1089\'84\'83\u1090\'84\'84\u1080\'84\'79 \u1080\'84\'79\u1079\'84\'78 \u1084\'84\'7d\u1085\'84\'7e\u1086\'84\'80\u1075\'84\'73\u1080\'84\'79\u1093\'84\'87 \u1091\'84\'85\u1082\'84\'7b\u1088\'84\'82\u1072\'84\'70\u1080\'84\'79\u1085\'84\'7e\u1089\'84\'83\u1082\'84\'7b\u1080\'84\'79\u1093\'84\'87 \u1080\'84\'79 \u1084\'84\'7d\u1077\'84\'75\u1078\'84\'77\u1076\'84\'74\u1091\'84\'85\u1085\'84\'7e\u1072\'84\'70\u1088\'84\'82\u1086\'84\'80\u1076\'84\'74\u1085\'84\'7e\u1099\'84\'8d\u1093\'84\'87 \u1080\'84\'79\u1089\'84\'83\u1090\'84\'84\u1086\'84\'80\u1095\'84\'89\u1085\'84\'7e\u1080\'84\'79\u1082\'84\'7b\u1086\'84\'80\u1074\'84\'72, \u1072\'84\'70 \u1090\'84\'84\u1072\'84\'70\u1082\'84\'7b\u1078\'84\'77\u1077\'84\'75 \u1087\'84\'81\u1088\'84\'82\u1072\'84\'70\u1082\'84\'7b\u1090\'84\'84\u1080\'84\'79\u1095\'84\'89\u1077\'84\'75\u1089\'84\'83\u1082\'84\'7b\u1080\'84\'79\u1077\'84\'75 \u1089\'84\'83\u1077\'84\'75\u1088\'84\'82\u1074\'84\'72\u1080\'84\'79\u1089\'84\'83\u1099\'84\'8d \u1080\'84\'79 \u1089\'84\'83\u1089\'84\'83\u1099\'84\'8d\u1083\'84\'7c\u1082\'84\'7b\u1080\'84\'79.\line \u1054\'84\'4f\u1089\'84\'83\u1085\'84\'7e\u1086\'84\'80\u1074\'84\'72\u1085\'84\'7e\u1099\'84\'8d\u1077\'84\'75 \u1085\'84\'7e\u1086\'84\'80\u1074\'84\'72\u1086\'84\'80\u1089\'84\'83\u1090\'84\'84\u1085\'84\'7e\u1099\'84\'8d\u1077\'84\'75 \u1088\'84\'82\u1072\'84\'70\u1079\'84\'78\u1076\'84\'74\u1077\'84\'75\u1083\'84\'7c\u1099\'84\'8d (\u1072\'84\'70\u1082\'84\'7b\u1090\'84\'84\u1091\'84\'85\u1072\'84\'70\u1083\'84\'7c\u1100\'84\'8e\u1085\'84\'7e\u1099\'84\'8d\u1077\'84\'75 \u1079\'84\'78\u1072\'84\'70\u1075\'84\'73\u1086\'84\'80\u1083\'84\'7c\u1086\'84\'80\u1074\'84\'72\u1082\'84\'7b\u1080\'84\'79 \u1085\'84\'7e\u1072\'84\'70 \u1084\'84\'7d\u1086\'84\'80\u1084\'84\'7d\u1077\'84\'75\u1085\'84\'7e\u1090\'84\'84 \u1087\'84\'81\u1088\'84\'82\u1086\'84\'80\u1089\'84\'83\u1084\'84\'7d\u1086\'84\'80\u1090\'84\'84\u1088\'84\'82\u1072\'84\'70):\line \u1043\'84\'43\u1086\'84\'80\u1083\'84\'7c\u1086\'84\'80\u1074\'84\'72\u1085\'84\'7e\u1077\'84\'75 (\u1043\'84\'43\u1083\'84\'7c\u1072\'84\'70\u1074\'84\'72\u1085\'84\'7e\u1086\'84\'80\u1077\'84\'75):\line \u1057\'84\'52\u1087\'84\'81\u1077\'84\'75\u1094\'84\'88\u1087\'84\'81\u1086\'84\'80\u1089\'84\'83\u1083\'84\'7c\u1072\'84\'70\u1085\'84\'7e\u1085\'84\'7e\u1080\'84\'79\u1082\'84\'7b \u1058\'84\'53\u1088\'84\'82\u1072\'84\'70\u1084\'84\'7d\u1087\'84\'81\u1072\'84\'70 \u1087\'84\'81\u1088\'84\'82\u1086\'84\'80\u1074\'84\'72\u1077\'84\'75\u1076\'84\'74\u1105\'84\'76\u1090\'84\'84 \u1087\'84\'81\u1077\'84\'75\u1088\'84\'82\u1077\'84\'75\u1075\'84\'73\u1086\'84\'80\u1074\'84\'72\u1086\'84\'80\u1088\'84\'82\u1099\'84\'8d \u1089\'84\'83 \u1083\'84\'7c\u1080\'84\'79\u1076\'84\'74\u1077\'84\'75\u1088\'84\'82\u1086\'84\'80\u1084\'84\'7d \u1061\'84\'56\u1040\'84\'40\u1052\'84\'4d\u1040\'84\'40\u1057\'84\'52\line \u1059\'84\'54\u1082\'84\'7b\u1088\'84\'82\u1072\'84\'70\u1080\'84\'79\u1085\'84\'7e\u1072\'84\'70 \u1080\'84\'79\u1089\'84\'83\u1087\'84\'81\u1086\'84\'80\u1083\'84\'7c\u1100\'84\'8e\u1079\'84\'78\u1091\'84\'85\u1077\'84\'75\u1090\'84\'84 \u1073\'84\'71\u1088\'84\'82\u1080\'84\'79\u1090\'84\'84\u1072\'84\'70\u1085\'84\'7e\u1089\'84\'83\u1082\'84\'7b\u1080\'84\'79\u1077\'84\'75 \u1076\'84\'74\u1088\'84\'82\u1086\'84\'80\u1085\'84\'7e\u1099\'84\'8d \u1076\'84\'74\u1083\'84\'7c\u1103\'84\'91 \u1076\'84\'74\u1072\'84\'70\u1083\'84\'7c\u1100\'84\'8e\u1085\'84\'7e\u1080\'84\'79\u1093\'84\'87 \u1091\'84\'85\u1076\'84\'74\u1072\'84\'70\u1088\'84\'82\u1086\'84\'80\u1074\'84\'72 \u1087\'84\'81\u1086\'84\'80 \u1056\'84\'51\u1060\'84\'55\line \u1042\'84\'42 \u1088\'84\'82\u1077\'84\'75\u1079\'84\'78\u1091\'84\'85\u1083\'84\'7c\u1100\'84\'8e\u1090\'84\'84\u1072\'84\'70\u1090\'84\'84\u1077\'84\'75 \u1074\'84\'72\u1088\'84\'82\u1072\'84\'70\u1078\'84\'77\u1077\'84\'75\u1089\'84\'83\u1082\'84\'7b\u1086\'84\'80\u1075\'84\'73\u1086\'84\'80 \u1088\'84\'82\u1072\'84\'70\u1082\'84\'7b\u1077\'84\'75\u1090\'84\'84\u1085\'84\'7e\u1086\'84\'80\u1075\'84\'73\u1086\'84\'80 \u1091\'84\'85\u1076\'84\'74\u1072\'84\'70\u1088\'84\'82\u1072\'84\'70 \u1087\'84\'81\u1086\'84\'80 \u1057\'84\'52\u1091\'84\'85\u1084\'84\'7d\u1097\'84\'8b\u1080\'84\'79\u1085\'84\'7e\u1077\'84\'75 \u1089\'84\'83\u1080\'84\'79\u1083\'84\'7c\u1100\'84\'8e\u1085\'84\'7e\u1086\'84\'80 \u1087\'84\'81\u1086\'84\'80\u1074\'84\'72\u1088\'84\'82\u1077\'84\'75\u1078\'84\'77\u1076\'84\'74\u1105\'84\'76\u1085\'84\'7e \u1101\'84\'8f\u1083\'84\'7c\u1077\'84\'75\u1074\'84\'72\u1072\'84\'70\u1090\'84\'84\u1086\'84\'80\u1088\'84\'82 \u1075\'84\'73\u1088\'84\'82\u1091\'84\'85\u1087\'84\'81\u1087\'84\'81\u1099\'84\'8d \u1082\'84\'7b\u1086\'84\'80\u1084\'84\'7d\u1087\'84\'81\u1072\'84\'70\u1085\'84\'7e\u1080\'84\'79\u1081\'84\'7a \uc1 \u171\'3f\uc2 \u1059\'84\'54\u1082\'84\'7b\u1088\'84\'82\u1083\'84\'7c\u1077\'84\'75\u1085\'84\'7e\u1076\'84\'74\u1092\'84\'86\u1072\'84\'70\u1088\'84\'82\u1084\'84\'7d\u1080\'84\'79\u1085\'84\'7e\u1075\'84\'73\uc1 \u187\'3f; \uc2 \u1088\'84\'82\u1072\'84\'70\u1085\'84\'7e\u1077\'84\'75\u1085\'84\'7e \u1089\'84\'83\u1086\'84\'80\u1090\'84\'84\u1088\'84\'82\u1091\'84\'85\u1076\'84\'74\u1085\'84\'7e\u1080\'84\'79\u1082\'84\'7b\line \u1042\'84\'42\uc1 \u1110\'3f\uc2 \u1081\'84\'7a\u1085\'84\'7e\u1072\'84\'70 (\u1042\'84\'42\u1086\'84\'80\u1081\'84\'7a\u1085\'84\'7e\u1072\'84\'70):\line \u1056\'84\'51\u1086\'84\'80\u1089\'84\'83\u1089\'84\'83\u1080\'84\'79\u1103\'84\'91\u1085\'84\'7e\u1077\'84\'75 \u1091\'84\'85\u1076\'84\'74\u1072\'84\'70\u1088\'84\'82\u1080\'84\'79\u1083\'84\'7c\u1080\'84\'79 \u1076\'84\'74\u1088\'84\'82\u1086\'84\'80\u1085\'84\'7e\u1086\'84\'80\u1084\'84\'7d \u1087\'84\'81\u1086\'84\'80 \u108