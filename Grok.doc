4\'70\u1089\'84\'83 2 \u1088\'84\'82\u1072\'84\'70\u1085\'84\'7e\u1077\'84\'75\u1085\'84\'7e\u1099\'84\'8d\u1093\'84\'87 \u1073\'84\'71\u1086\'84\'80\u1081\'84\'7a\u1094\'84\'88\u1086\'84\'80\u1074\'84\'72\line \u1040\'84\'40\u1085\'84\'7e\u1072\'84\'70\u1083\'84\'7c\u1080\'84\'79\u1079\'84\'78 \u1089\'84\'83\u1080\'84\'79\u1090\'84\'84\u1091\'84\'85\u1072\'84\'70\u1094\'84\'88\u1080\'84\'79\u1080\'84\'79 \u1085\'84\'7e\u1072\'84\'70 \u1092\'84\'86\u1088\'84\'82\u1086\'84\'80\u1085\'84\'7e\u1090\'84\'84\u1077\'84\'75 \u1074\'84\'72 \u1080\'84\'79\u1102\'84\'90\u1083\'84\'7c\u1077\'84\'75 (\u1087\'84\'81\u1086\'84\'80\u1090\'84\'84\u1077\'84\'75\u1088\'84\'82\u1080\'84\'79 \u1056\'84\'51\u1086\'84\'80\u1089\'84\'83\u1089\'84\'83\u1080\'84\'79\u1080\'84\'79, \u1074\'84\'72\u1086\'84\'80\u1079\'84\'78\u1074\'84\'72\u1088\'84\'82\u1072\'84\'70\u1097\'84\'8b\u1077\'84\'75\u1085\'84\'7e\u1080\'84\'79\u1077\'84\'75 \u1090\'84\'84\u1077\'84\'75\u1088\'84\'82\u1088\'84\'82\u1080\'84\'79\u1090\'84\'84\u1086\'84\'80\u1088\'84\'82\u1080\'84\'79\u1081\'84\'7a \u1059\'84\'54\u1082\'84\'7b\u1088\'84\'82\u1072\'84\'70\u1080\'84\'79\u1085\'84\'7e\u1086\'84\'80\u1081\'84\'7a)\line \u1055\'84\'50\u1072\'84\'70\u1085\'84\'7e\u1080\'84\'79\u1082\'84\'7b\u1072\'84\'70 \u1085\'84\'7e\u1072\'84\'70 \u1040\'84\'40\u1047\'84\'48\u1057\'84\'52 \u1080\'84\'79 \u1086\'84\'80\u1095\'84\'89\u1077\'84\'75\u1088\'84\'82\u1077\'84\'75\u1076\'84\'74\u1080\'84\'79 \u1079\'84\'78\u1072\'84\'70 \u1073\'84\'71\u1077\'84\'75\u1085\'84\'7e\u1079\'84\'78\u1080\'84\'79\u1085\'84\'7e\u1086\'84\'80\u1084\'84\'7d \u1074\'84\'72 \u1056\'84\'51\u1086\'84\'80\u1089\'84\'83\u1089\'84\'83\u1080\'84\'79\u1080\'84\'79\line \u1055\'84\'50\u1086\'84\'80\u1083\'84\'7c\uc1 \u1110\'3f\uc2 \u1090\'84\'84\u1080\'84\'79\u1082\'84\'7b\u1072\'84\'70 (\u1055\'84\'50\u1086\'84\'80\u1083\'84\'7c\u1080\'84\'79\u1090\'84\'84\u1080\'84\'79\u1082\'84\'7b\u1072\'84\'70):\line \u1054\'84\'4f\u1073\'84\'71\u1089\'84\'83\u1091\'84\'85\u1078\'84\'77\u1076\'84\'74\u1077\'84\'75\u1085\'84\'7e\u1080\'84\'79\u1103\'84\'91 \u1073\'84\'71\u1077\'84\'75\u1079\'84\'78\u1086\'84\'80\u1087\'84\'81\u1072\'84\'70\u1089\'84\'83\u1085\'84\'7e\u1086\'84\'80\u1089\'84\'83\u1090\'84\'84\u1080\'84\'79 \u1063\'84\'58\u1105\'84\'76\u1088\'84\'82\u1085\'84\'7e\u1086\'84\'80\u1075\'84\'73\u1086\'84\'80 \u1084\'84\'7d\u1086\'84\'80\u1088\'84\'82\u1103\'84\'91 \u1080\'84\'79 \u1088\'84\'82\u1086\'84\'80\u1089\'84\'83\u1089\'84\'83\u1080\'84\'79\u1081\'84\'7a\u1089\'84\'83\u1082\'84\'7b\u1080\'84\'79\u1093\'84\'87 \u1091\'84\'85\u1076\'84\'74\u1072\'84\'70\u1088\'84\'82\u1086\'84\'80\u1074\'84\'72 \u1087\'84\'81\u1086\'84\'80 \u1087\'84\'81\u1086\'84\'80\u1088\'84\'82\u1090\'84\'84\u1072\'84\'70\u1084\'84\'7d\line \u1059\'84\'54\u1082\'84\'7b\u1088\'84\'82\u1072\'84\'70\u1080\'84\'79\u1085\'84\'7e\u1072\'84\'70 \u1080\'84\'79 \u1040\'84\'40\u1079\'84\'78\u1077\'84\'75\u1088\'84\'82\u1073\'84\'71\u1072\'84\'70\u1081\'84\'7a\u1076\'84\'74\u1078\'84\'77\u1072\'84\'70\u1085\'84\'7e \u1091\'84\'85\u1089\'84\'83\u1080\'84\'79\u1083\'84\'7c\u1080\'84\'79\u1074\'84\'72\u1072\'84\'70\u1102\'84\'90\u1090\'84\'84 \u1089\'84\'83\u1086\'84\'80\u1090\'84\'84\u1088\'84\'82\u1091\'84\'85\u1076\'84\'74\u1085\'84\'7e\u1080\'84\'79\u1095\'84\'89\u1077\'84\'75\u1089\'84\'83\u1090\'84\'84\u1074\'84\'72\u1086\'84\'80 \u1074\'84\'72 \u1087\'84\'81\u1088\'84\'82\u1072\'84\'70\u1074\'84\'72\u1086\'84\'80\u1086\'84\'80\u1093\'84\'87\u1088\'84\'82\u1072\'84\'70\u1085\'84\'7e\u1080\'84\'79\u1090\'84\'84\u1077\'84\'75\u1083\'84\'7c\u1100\'84\'8e\u1085\'84\'7e\u1086\'84\'80\u1081\'84\'7a \u1089\'84\'83\u1092\'84\'86\u1077\'84\'75\u1088\'84\'82\u1077\'84\'75\line \u1047\'84\'48\u1077\'84\'75\u1083\'84\'7c\u1077\'84\'75\u1085\'84\'7e\u1089\'84\'83\u1082\'84\'7b\u1080\'84\'79\u1081\'84\'7a \u1086\'84\'80 \u1087\'84\'81\u1086\'84\'80\u1089\'84\'83\u1083\'84\'7c\u1077\'84\'75\u1076\'84\'74\u1089\'84\'83\u1090\'84\'84\u1074\'84\'72\u1080\'84\'79\u1103\'84\'91\u1093\'84\'87 \u1084\'84\'7d\u1072\'84\'70\u1089\'84\'83\u1089\'84\'83\u1080\'84\'79\u1088\'84\'82\u1086\'84\'80\u1074\'84\'72\u1072\'84\'70\u1085\'84\'7e\u1085\'84\'7e\u1099\'84\'8d\u1093\'84\'87 \u1072\'84\'70\u1090\'84\'84\u1072\'84\'70\u1082\'84\'7b\line \u1055\'84\'50\u1088\'84\'82\u1077\'84\'75\u1076\'84\'74\u1091\'84\'85\u1087\'84\'81\u1088\'84\'82\u1077\'84\'75\u1078\'84\'77\u1076\'84\'74\u1077\'84\'75\u1085\'84\'7e\u1080\'84\'79\u1103\'84\'91 \u1086\'84\'80 \u1089\'84\'83\u1086\'84\'80\u1093\'84\'87\u1088\'84\'82\u1072\'84\'70\u1085\'84\'7e\u1103\'84\'91\u1102\'84\'90\u1097\'84\'8b\u1077\'84\'75\u1081\'84\'7a\u1089\'84\'83\u1103\'84\'91 \u1091\'84\'85\u1075\'84\'73\u1088\'84\'82\u1086\'84\'80\u1079\'84\'78\u1077\'84\'75 \u1076\'84\'74\u1083\'84\'7c\u1103\'84\'91 \u1053\'84\'4e\u1040\'84\'40\u1058\'84\'53\u1054\'84\'4f, \u1087\'84\'81\u1086\'84\'80\u1082\'84\'7b\u1072\'84\'70 \u1056\'84\'51\u1086\'84\'80\u1089\'84\'83\u1089\'84\'83\u1080\'84\'79\u1103\'84\'91 \u1087\'84\'81\u1088\'84\'82\u1086\'84\'80\u1076\'84\'74\u1086\'84\'80\u1083\'84\'7c\u1078\'84\'77\u1072\'84\'70\u1077\'84\'75\u1090\'84\'84 \u1074\'84\'72\u1086\'84\'80\u1081\'84\'7a\u1085\'84\'7e\u1091\'84\'85\line \u1057\'84\'52\u1086\'84\'80\u1086\'84\'80\u1073\'84\'71\u1097\'84\'8b\u1077\'84\'75\u1085\'84\'7e\u1080\'84\'79\u1103\'84\'91 \u1086\'84\'80 \u1084\'84\'7d\u1072\'84\'70\u1089\'84\'83\u1089\'84\'83\u1086\'84\'80\u1074\'84\'72\u1099\'84\'8d\u1093\'84\'87 \u1087\'84\'81\u1088\'84\'82\u1086\'84\'80\u1090\'84\'84\u1077\'84\'75\u1089\'84\'83\u1090\'84\'84\u1072\'84\'70\u1093\'84\'87 \u1074\'84\'72 \u1056\'84\'51\u1086\'84\'80\u1089\'84\'83\u1089\'84\'83\u1080\'84\'79\u1080\'84\'79 \u1089\'84\'83 \u1090\'84\'84\u1088\'84\'82\u1077\'84\'75\u1073\'84\'71\u1086\'84\'80\u1074\'84\'72\u1072\'84\'70\u1085\'84\'7e\u1080\'84\'79\u1077\'84\'75\u1084\'84\'7d \u1087\'84\'81\u1088\'84\'82\u1077\'84\'75\u1082\'84\'7b\u1088\'84\'82\u1072\'84\'70\u1090\'84\'84\u1080\'84\'79\u1090\'84\'84\u1100\'84\'8e \u1074\'